---
/**
 * Marco — cabecera, rail de secciones y contenido.
 *
 * DOS PORTALES EN UNO (decidido por el operador el 02/09/2026):
 *
 *   - Lo que ve Alfredo: inicio, los ocho modulos, los casos reales y las
 *     observaciones. Nada mas. Sin buscador, sin codigos y sin el aviso de
 *     «no probado»: lo que no esta probado es la transcripcion del metodo,
 *     no el metodo, y repetirselo cuatro veces no le sirve de nada.
 *
 *   - Lo que ve el operador: todo lo anterior mas «Todo el detalle» y el
 *     buscador. Se enciende con el icono discreto del pie del rail, que
 *     lleva a /tecnico, o con ?tecnico=1 en cualquier direccion.
 *
 * El aviso de «no probado» y los cuatro huecos declarados viven ahora en
 * /tecnico. Se muestran, no se esconden — pero del lado del operador.
 */
import * as P from '../lib/parsers.mjs';
import { MODULOS } from '../lib/modulos.mjs';
import Icono from './Icono.astro';
import Marca from './Marca.astro';
import Observaciones from './Observaciones.astro';
import '../estilos/tokens.css';
import '../estilos/base.css';

interface Props { titulo: string; ancho?: 'texto' | 'total' }
const { titulo, ancho = 'total' } = Astro.props;

const indice = P.indiceBusqueda();

// El menu es el recorrido del metodo, en el orden real de la jornada. Los
// ocho modulos van numerados a proposito: el numero no decora, es el orden
// cronologico de la sesion y sin el la lista no se entiende igual.
const GRUPOS = [
  {
    items: [{ icono: 'house', href: '/', texto: 'Inicio', tono: 'var(--acento)' }],
  },
  {
    // El tono sale de modulos.mjs, que es donde se calcula una sola vez, para
    // que el menu y el titulo de los apartados usen exactamente el mismo.
    items: MODULOS.map((m) => ({
      n: m.n, icono: m.icono, href: '/' + m.slug, texto: m.corto, tono: m.tono,
    })),
  },
  {
    items: [
      { icono: 'images', href: '/galeria', texto: 'Casos reales', cuenta: P.galeria().length, tono: 'var(--info)' },
      { icono: 'chat-teardrop-text', href: '/observaciones', texto: 'Observaciones', tono: 'var(--acento)' },
    ],
  },
  {
    // Solo en modo tecnico. Es el detalle de auditoria: al revisor le sobra,
    // y tenerlo delante invita a perderse en las 38 fichas.
    grupo: 'Todo el detalle',
    soloTecnico: true,
    items: [
      { icono: 'compass', href: '/tecnico', texto: 'Portada técnica' },
      { icono: 'file-text', href: '/plan-completo', texto: 'El plan completo' },
      { icono: 'list-checks', href: '/reglas', texto: 'Las reglas', cuenta: P.reglas().length },
      { icono: 'book-open', href: '/glosario', texto: 'Vocabulario', cuenta: P.glosario().length },
      { icono: 'sliders-horizontal', href: '/parametros', texto: 'Parámetros' },
      { icono: 'check-square', href: '/checklist', texto: 'Checklist diaria' },
      { icono: 'warning-circle', href: '/pendientes', texto: 'Pendientes' },
      { icono: 'stack', href: '/contextualizacion', texto: 'Contextualización' },
      { icono: 'seal-check', href: '/cierre', texto: 'Acta de cierre' },
    ],
  },
];

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const activa = (href: string) =>
  ruta === href.replace(/\/$/, '') || (href !== '/' && ruta.startsWith(href));
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo} · Trading Plan de Futuros NQ</title>
  </head>

  <body class="sin-js">
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
      <!-- El banner va centrado en la cabecera, no pegado a la izquierda:
           es la marca del portal, no una etiqueta de barra de herramientas. -->
      <div class="cab-marca"><Marca /></div>

      <!-- El buscador indexa reglas, parametros y pendientes: material del
           operador. Un recorrido de ocho modulos en orden no se busca, se
           recorre. Por eso solo aparece en modo tecnico. -->
      <button class="buscar solo-tecnico" type="button" data-abrir-buscador>
        <svg class="buscar-i" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.6" />
          <path d="M13.5 13.5 17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <span class="buscar-t">Buscar una regla, un término, un caso</span>
        <kbd class="tecla">Ctrl K</kbd>
      </button>
    </header>

    <div class="marco">
      <aside class="rail">
        <nav class="nav" aria-label="Secciones">
          {GRUPOS.map((g) => (
            <div class:list={['nav-g', { 'solo-tecnico': g.soloTecnico }]}>
              {g.grupo && <p class="etiqueta nav-t">{g.grupo}</p>}
              {g.items.map((s) => (
                <a href={s.href} class:list={['nav-i', { activa: activa(s.href) }]}>
                  <span class="nav-ic" style={s.tono ? `--tono:${s.tono}` : undefined}><Icono nombre={s.icono} /></span>
                  <span class="nav-x">{s.texto}</span>
                  {s.n && <span class="nav-n num">{String(s.n).padStart(2, '0')}</span>}
                  {s.cuenta && <span class="nav-c num">{s.cuenta}</span>}
                </a>
              ))}
            </div>
          ))}
        </nav>

        <div class="rail-pie">
          <!-- Rastro del modo tecnico. No es un interruptor a la vista: es la
               forma de saber que esta puesto y de poder quitarlo. -->
          <a class="tec-chip solo-tecnico" href="/?tecnico=0">
            <span class="tec-punto" aria-hidden="true"></span>
            <span>Modo técnico encendido</span>
            <span class="tec-off meta">apagar</span>
          </a>

          <!-- La puerta del operador. Discreta a proposito: Alfredo no
               necesita el detalle de auditoria y no debe tropezar con el.
               Lleva a /tecnico y de paso enciende el modo. -->
          <a class="puerta" href="/tecnico?tecnico=1" aria-label="Portada técnica">
            <Icono nombre="gear-six" />
          </a>
        </div>
      </aside>

      <div class="cuerpo">
        <main id="contenido" class:list={['contenido', ancho]}>
          <slot />
        </main>

        <footer class="pie">
          <p class="meta">
            © <strong>Christian Buitrago</strong> ·{' '}
            <a href="mailto:kristeb@hotmail.com">kristeb@hotmail.com</a>
          </p>
          <p class="meta">Versión 1.0</p>
        </footer>
      </div>
    </div>

    <!-- Buscador. Un dialog nativo: cierra con Esc y atrapa el foco solo. -->
    <dialog class="paleta" data-paleta aria-label="Buscar en el plan">
      <div class="paleta-in">
        <div class="paleta-campo">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.6" />
            <path d="M13.5 13.5 17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <input type="search" data-paleta-entrada autocomplete="off" spellcheck="false"
                 placeholder="Escribe para buscar entre reglas, términos, casos y parámetros" />
          <kbd class="tecla">Esc</kbd>
        </div>
        <div class="paleta-lista" data-paleta-lista role="listbox" aria-label="Resultados"></div>
        <div class="paleta-pie meta">
          <span>{indice.length} entradas indexadas</span>
          <span><kbd class="tecla">↑</kbd> <kbd class="tecla">↓</kbd> moverse, <kbd class="tecla">Enter</kbd> abrir</span>
        </div>
      </div>
    </dialog>

    <Observaciones />

    <script type="application/json" data-indice set:html={JSON.stringify(indice)} />

    <script is:inline>
      document.body.classList.remove('sin-js');

      // ── modo técnico ──────────────────────────────────────────────────
      // Los códigos de regla van ocultos por defecto: «R-22» no le dice nada
      // a quien llega nuevo. Quien audita lo enciende una vez y se recuerda.
      (function () {
        var CLAVE = 'chaumer.tecnico';
        var on = false;
        try { on = localStorage.getItem(CLAVE) === '1'; } catch (e) { /* sin almacenamiento */ }

        // El operador abre su enlace con ?tecnico=1 una vez y su navegador
        // lo recuerda. Es el mismo mecanismo que el nombre del revisor.
        try {
          var u = new URL(window.location.href);
          if (u.searchParams.has('tecnico')) {
            on = u.searchParams.get('tecnico') !== '0';
            localStorage.setItem(CLAVE, on ? '1' : '0');
            u.searchParams.delete('tecnico');
            history.replaceState({}, '', u.pathname + u.search + u.hash);
          }
        } catch (e) { /* sin almacenamiento */ }

        document.body.classList.toggle('tecnico', on);
      })();
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var hayIO = 'IntersectionObserver' in window;

        // ── entrada al aparecer ─────────────────────────────────────────
        var objetivos = document.querySelectorAll('.entra');
        if (!hayIO || reduce) {
          objetivos.forEach(function (e) { e.classList.add('visible'); });
        } else {
          var obs = new IntersectionObserver(function (filas) {
            filas.forEach(function (f) {
              if (!f.isIntersecting) return;
              f.target.classList.add('visible');
              obs.unobserve(f.target);
            });
          }, { rootMargin: '0px 0px -5% 0px', threshold: 0.05 });
          objetivos.forEach(function (e) { obs.observe(e); });
        }

        // ── buscador ────────────────────────────────────────────────────
        var dlg = document.querySelector('[data-paleta]');
        var campo = document.querySelector('[data-paleta-entrada]');
        var lista = document.querySelector('[data-paleta-lista]');
        var crudo = document.querySelector('[data-indice]');
        if (!dlg || !campo || !lista || !crudo) return;

        var datos = JSON.parse(crudo.textContent);
        var sel = 0, vistos = [];

        var ETIQUETAS = {
          regla: 'Regla', termino: 'Término', caso: 'Caso',
          parametro: 'Parámetro', pendiente: 'Pendiente',
        };

        function normalizar(s) {
          return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
        }

        function buscar(q) {
          var t = normalizar(q).split(/\s+/).filter(Boolean);
          if (!t.length) return datos.slice(0, 8);
          return datos
            .map(function (d) {
              var titulo = normalizar(d.titulo), todo = normalizar(d.texto + ' ' + d.id);
              var p = 0;
              for (var i = 0; i < t.length; i++) {
                if (normalizar(d.id) === t[i]) p += 100;
                else if (normalizar(d.id).indexOf(t[i]) === 0) p += 40;
                if (titulo.indexOf(t[i]) >= 0) p += 12;
                if (todo.indexOf(t[i]) >= 0) p += 3;
                else if (normalizar(d.id).indexOf(t[i]) < 0 && titulo.indexOf(t[i]) < 0) return null;
              }
              return { d: d, p: p };
            })
            .filter(Boolean)
            .sort(function (a, b) { return b.p - a.p; })
            .slice(0, 30)
            .map(function (x) { return x.d; });
        }

        function pintar() {
          vistos = buscar(campo.value);
          sel = 0;
          if (!vistos.length) {
            lista.innerHTML = '<p class="paleta-vacio">Nada coincide con esa búsqueda. '
              + 'Prueba con el número de una regla, una palabra del glosario o una fecha.</p>';
            return;
          }
          lista.innerHTML = vistos.map(function (d, i) {
            return '<a class="paleta-r' + (i === 0 ? ' sel' : '') + '" href="' + d.url + '" role="option">'
              + '<span class="paleta-tipo">' + (ETIQUETAS[d.tipo] || d.tipo) + '</span>'
              + '<span class="paleta-t">' + d.titulo.replace(/[<>&]/g, '') + '</span>'
              + '<span class="paleta-id mono">' + d.id + '</span>'
              + '</a>';
          }).join('');
        }

        function mover(paso) {
          var filas = lista.querySelectorAll('.paleta-r');
          if (!filas.length) return;
          filas[sel].classList.remove('sel');
          sel = (sel + paso + filas.length) % filas.length;
          filas[sel].classList.add('sel');
          filas[sel].scrollIntoView({ block: 'nearest' });
        }

        function abrir() {
          // El buscador es del operador. Sin modo tecnico no existe, ni con
          // el atajo: si no, Alfredo lo abre sin querer y ve las 38 fichas.
          if (!document.body.classList.contains('tecnico')) return;
          if (dlg.open) return;
          dlg.showModal();
          campo.value = '';
          pintar();
          campo.focus();
        }

        document.querySelectorAll('[data-abrir-buscador]').forEach(function (b) {
          b.addEventListener('click', abrir);
        });

        document.addEventListener('keydown', function (e) {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); abrir(); }
        });

        campo.addEventListener('input', pintar);
        campo.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowDown') { e.preventDefault(); mover(1); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); mover(-1); }
          else if (e.key === 'Enter') {
            var f = lista.querySelectorAll('.paleta-r')[sel];
            if (f) { e.preventDefault(); window.location.href = f.getAttribute('href'); }
          }
        });

        // Clic fuera del panel cierra.
        dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
      })();
    </script>

    <style>
      .saltar {
        position: fixed; left: var(--e-3); top: var(--e-3); z-index: 60;
        padding: var(--e-2) var(--e-3);
        background: var(--elevado); border: 1px solid var(--borde);
        border-radius: var(--radio-1);
        transform: translateY(-250%);
      }
      .saltar:focus { transform: none; }

      /* ── cabecera ──────────────────────────────────────────────────── */
      /* Tres columnas iguales a los lados para que el banner quede centrado
         de verdad en la pagina, no «centrado en lo que sobra». */
      .cabecera {
        position: sticky; top: 0; z-index: 40;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: center;
        gap: var(--e-5);
        /* Alto fijo: el rail cuelga de aqui y necesita saber cuanto mide. */
        min-height: var(--alto-cabecera);
        padding: var(--e-3) var(--e-6);
        background: color-mix(in srgb, var(--fondo) 86%, transparent);
        backdrop-filter: var(--desenfoque);
        border-bottom: 1px solid var(--borde-sutil);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04), var(--sombra-2);
        isolation: isolate;
      }
      /* Detras del banner, un foco de luz azul muy suave. Nada mas.
         Aqui hubo una fila de velas dibujadas y el operador la rechazo:
         «se ven horribles». No se sustituye por otro dibujo — un foco de luz
         da modernidad sin fingir un grafico que no existe. */
      .cabecera::before {
        content: '';
        position: absolute; inset: 0; z-index: 0;
        background: radial-gradient(38rem 12rem at 50% -30%,
                    color-mix(in srgb, var(--acento) 26%, transparent), transparent 70%);
        pointer-events: none;
      }
      .cab-marca { grid-column: 2; justify-self: center; position: relative; z-index: 1; }

      /* Buscador: solo del lado del operador. Va a la izquierda del banner. */
      .buscar {
        grid-column: 1; grid-row: 1; position: relative; z-index: 1;
        display: flex; align-items: center; gap: var(--e-3);
        width: 100%; max-width: 26rem;
        min-height: var(--alto-control);
        padding: var(--e-2) var(--e-3);
        background: var(--superficie);
        border: 1px solid var(--borde);
        border-radius: var(--radio-2);
        color: var(--texto-3);
        font: inherit; font-size: var(--t-3);
        cursor: pointer; text-align: left;
        transition: border-color var(--normal), background var(--normal);
      }
      .buscar:hover { border-color: var(--n-600); background: var(--tarjeta); }
      .buscar-i { width: 16px; height: 16px; flex: none; }
      .buscar-t { flex: 1; }

      /* ── rastro del modo técnico ───────────────────────────────────── */
      .tec-chip {
        display: flex; align-items: center; gap: var(--e-2);
        padding: var(--e-2) var(--e-3);
        border-radius: var(--radio-2);
        border: 1px solid var(--borde-sutil);
        background: color-mix(in srgb, var(--acento) 6%, transparent);
        font-size: var(--t-1);
        color: var(--texto-3);
        transition: border-color var(--normal), color var(--normal);
      }
      .tec-chip:hover { border-color: var(--n-600); color: var(--texto-2); }
      .tec-punto {
        width: 6px; height: 6px; border-radius: 50%;
        background: var(--acento); flex: none;
      }
      .tec-off { margin-left: auto; }

      /* ── rail ──────────────────────────────────────────────────────── */
      .marco { display: grid; grid-template-columns: var(--rail) minmax(0, 1fr); }

      .rail {
        position: sticky; top: var(--alto-cabecera); align-self: start;
        height: calc(100dvh - var(--alto-cabecera));
        display: flex; flex-direction: column; gap: var(--e-4);
        padding: var(--e-4) var(--e-3);
        margin: var(--e-4) 0 var(--e-4) var(--e-4);
        border-radius: var(--radio-4);
        background: var(--vidrio-fondo);
        background-image: var(--vidrio-brillo);
        backdrop-filter: var(--desenfoque);
        border: 1px solid var(--vidrio-borde);
        overflow-y: auto;
      }
      .nav { flex: 1; }
      .nav-g { margin-bottom: var(--e-3); }
      .nav-g + .nav-g { padding-top: var(--e-3); border-top: 1px solid var(--borde-sutil); }
      .nav-t { margin: 0 0 var(--e-2); padding-left: var(--e-3); }

      .nav-i {
        position: relative;
        display: grid; grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center; gap: var(--e-3);
        min-height: var(--alto-control);
        padding: var(--e-2) var(--e-3);
        border-radius: var(--radio-2);
        font-size: var(--t-3);
        color: var(--texto-2);
        transition: background var(--normal), color var(--normal), transform var(--normal);
      }

      /* El icono deja de ser un glifo suelto y pasa a ser un objeto: azulejo
         teñido, borde de luz arriba y sombra abajo. El tono lo pone cada
         entrada del menú (--tono); si no lo trae, queda neutro. */
      .nav-ic {
        display: grid; place-items: center;
        width: 1.75rem; height: 1.75rem; flex: none;
        border-radius: var(--radio-2);
        color: var(--tono, var(--texto-3));
        background: color-mix(in srgb, var(--tono, var(--n-500)) 14%, transparent);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12),
                    inset 0 0 0 1px color-mix(in srgb, var(--tono, var(--n-500)) 26%, transparent),
                    0 1px 3px rgba(5, 8, 14, 0.5);
        --i: 1rem;
        transition: background var(--normal), box-shadow var(--normal), transform var(--normal);
      }
      .nav-x { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

      /* El numero del modulo va detras, no delante: el icono abre la fila y
         el numero cierra el orden. Misma columna que el contador de casos,
         asi que el rail no baila al mezclar unos con otros. */
      .nav-n {
        font-size: var(--t-1);
        letter-spacing: var(--track-cifra);
        color: var(--texto-3);
        transition: color var(--normal);
      }

      .nav-i:hover { background: var(--vidrio-hover); color: var(--texto); transform: translateX(2px); }
      .nav-i:hover .nav-ic {
        background: color-mix(in srgb, var(--tono, var(--n-500)) 26%, transparent);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.20),
                    inset 0 0 0 1px color-mix(in srgb, var(--tono, var(--n-500)) 45%, transparent),
                    0 3px 8px rgba(5, 8, 14, 0.6);
        transform: translateY(-1px);
      }
      .nav-i:hover .nav-n { color: var(--acento); }

      /* Activa: fondo en degradado, icono en color y una barra de luz a la
         izquierda. Tres senales, no solo el color de fondo. */
      .nav-i.activa {
        color: var(--texto); font-weight: var(--peso-medio);
        background: linear-gradient(90deg,
                    color-mix(in srgb, var(--acento) 22%, transparent),
                    color-mix(in srgb, var(--acento) 6%, transparent));
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--acento) 22%, transparent);
      }
      .nav-i.activa::before {
        content: '';
        position: absolute; left: 0; top: 20%; bottom: 20%;
        width: 2px; border-radius: var(--radio-pill);
        background: var(--acento);
        box-shadow: 0 0 10px 1px color-mix(in srgb, var(--acento) 75%, transparent);
      }
      .nav-i.activa .nav-n { color: var(--acento); }
      /* Activa: el azulejo se enciende del todo, con su propio tono. */
      .nav-i.activa .nav-ic {
        background: color-mix(in srgb, var(--tono, var(--acento)) 85%, transparent);
        color: var(--sobre-acento);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.30),
                    0 3px 10px color-mix(in srgb, var(--tono, var(--acento)) 45%, transparent);
      }

      .nav-c {
        font-size: var(--t-1); color: var(--texto-3);
        background: var(--vidrio-hover);
        border-radius: var(--radio-pill);
        padding: 1px var(--e-2); min-width: 1.6rem; text-align: center;
      }
      .nav-i.activa .nav-c { background: color-mix(in srgb, var(--acento) 26%, transparent); color: var(--texto); }

      /* ── pie del rail ──────────────────────────────────────────────── */
      .rail-pie { display: grid; gap: var(--e-2); justify-items: end; }
      .tec-chip { justify-self: stretch; }

      /* La puerta al detalle: un icono pequeño y apagado. Se ve si se busca,
         no llama si no. Al enfocar o pasar por encima se declara. */
      /* Caja de 44px para poder tocarla en el movil; el icono de dentro sigue
         siendo diminuto, que es lo que pidio el operador. */
      .puerta {
        display: flex; align-items: center; justify-content: center;
        width: var(--alto-control); height: var(--alto-control);
        border-radius: var(--radio-2);
        color: var(--n-500);
        --i: 0.875rem;
        transition: color var(--normal), background var(--normal);
      }
      .puerta:hover { color: var(--texto-2); background: var(--vidrio-hover); }

      /* ── contenido ─────────────────────────────────────────────────── */
      .cuerpo { display: flex; flex-direction: column; min-width: 0; }
      .contenido { flex: 1; width: 100%; padding: var(--e-8) var(--e-7) var(--e-9); }
      .contenido.texto { max-width: 52rem; }
      .contenido.total { max-width: var(--ancho); }

      .pie {
        border-top: 1px solid var(--borde-sutil);
        padding: var(--e-6) var(--e-7);
        display: flex; flex-wrap: wrap; gap: var(--e-2) var(--e-5);
        justify-content: center; text-align: center;
      }
      .pie p { margin: 0; }

      /* ── paleta de busqueda ────────────────────────────────────────── */
      .paleta {
        width: min(38rem, calc(100vw - 2rem));
        margin-top: 12vh;
        padding: 0;
        background: var(--tarjeta);
        border: 0;
        border-radius: var(--radio-3);
        box-shadow: var(--sombra-3);
        color: var(--texto);
        overflow: hidden;
      }
      .paleta::backdrop { background: color-mix(in srgb, var(--n-950) 78%, transparent); backdrop-filter: blur(3px); }

      .paleta-campo {
        display: flex; align-items: center; gap: var(--e-3);
        padding: var(--e-4) var(--e-5);
        border-bottom: 1px solid var(--borde-sutil);
      }
      .paleta-campo svg { width: 18px; height: 18px; color: var(--texto-3); flex: none; }
      .paleta-campo input {
        flex: 1; background: none; border: 0; outline: none;
        color: var(--texto); font: inherit; font-size: var(--t-5);
      }
      .paleta-campo input::placeholder { color: var(--texto-3); }
      .paleta-campo input::-webkit-search-cancel-button { display: none; }

      .paleta-lista { max-height: 22rem; overflow-y: auto; padding: var(--e-2); }
      /* Estos nodos los crea el JS, asi que van sin ambito. */
      .paleta-lista :global(.paleta-r) {
        display: grid;
        grid-template-columns: 5.5rem minmax(0, 1fr) auto;
        align-items: center; gap: var(--e-3);
        padding: var(--e-3);
        border-radius: var(--radio-1);
        color: var(--texto-2);
      }
      .paleta-lista :global(.paleta-r.sel) { background: var(--elevado); color: var(--texto); }
      .paleta-lista :global(.paleta-tipo) { font-size: var(--t-1); color: var(--texto-3); letter-spacing: var(--track-etiqueta); text-transform: uppercase; }
      .paleta-lista :global(.paleta-t) { font-size: var(--t-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .paleta-lista :global(.paleta-id) { font-size: var(--t-1); color: var(--texto-3); }
      .paleta-lista :global(.paleta-vacio) { padding: var(--e-5); margin: 0; color: var(--texto-3); font-size: var(--t-3); }

      .paleta-pie {
        display: flex; justify-content: space-between; gap: var(--e-4);
        padding: var(--e-3) var(--e-5);
        border-top: 1px solid var(--borde-sutil);
        background: var(--superficie);
      }

      /* ── responsive ────────────────────────────────────────────────── */
      /* 900px es el unico punto de ruptura del portal. Las paginas no
         inventan el suyo: si el rail cambia de forma aqui, todo cambia aqui. */
      @media (max-width: 900px) {
        /* En vertical la cabecera se apila: el banner arriba, centrado, y
           el buscador debajo a todo el ancho. En tres columnas el buscador
           se partia en tres lineas y empujaba la marca fuera de la pagina. */
        .cabecera {
          grid-template-columns: minmax(0, 1fr);
          gap: var(--e-2);
          padding: var(--e-3) var(--e-4);
        }
        .cab-marca { grid-column: 1; grid-row: 1; }
        .buscar { grid-column: 1; grid-row: 2; max-width: none; }
        .marco { grid-template-columns: 1fr; }
        .rail {
          position: static; height: auto;
          margin: 0; border-radius: 0;
          padding: var(--e-3) var(--e-4);
          border: 0; border-bottom: 1px solid var(--borde-sutil);
          overflow-x: auto;
          flex-direction: row; align-items: center; gap: var(--e-3);
        }
        .nav { flex: none; }
        .rail nav { display: flex; gap: var(--e-3); }
        .nav-g { margin-bottom: 0; display: flex; align-items: center; gap: var(--e-1); }
        .nav-g + .nav-g { padding-top: 0; border-top: 0; border-left: 1px solid var(--borde-sutil); padding-left: var(--e-3); }
        .nav-t { display: none; }
        /* Sin esto los items se encogen hasta que la etiqueta mide 0px y el
           menu queda como una tira de numeros sin nombre. Lo pago una vez.
           Dos cosas hacen falta, y las dos: que la fila no se encoja
           (longhands, porque el compilador se come el atajo `flex: none`) y
           que la columna del texto sea `auto` en vez de `minmax(0, 1fr)`,
           que es la que permite llegar a cero. */
        .nav-i {
          flex-grow: 0; flex-shrink: 0; flex-basis: auto;
          grid-template-columns: auto auto auto;
          white-space: nowrap;
        }
        .nav-x { overflow: visible; text-overflow: clip; }
        .rail-pie { display: flex; align-items: center; gap: var(--e-2); margin-left: auto; }
        .contenido { padding: var(--e-6) var(--e-4) var(--e-8); }
        .pie { padding: var(--e-5) var(--e-4); }
      }
    </style>
  </body>
</html>
