---
/**
 * Marco — cinta de estado, rail de navegacion y contenido.
 *
 * Lenguaje: rejilla suiza + terminal de datos. Radio cero, sin sombras.
 * La estructura la dibujan los FILETES, no las cajas.
 *
 * El aviso de «no probado» lo pone el marco, no la pagina: ninguna pantalla
 * puede esconderlo. Va en oro — advertencia, no error. El rojo se reserva
 * para un dato negativo de verdad.
 */
import * as P from '../lib/parsers.mjs';
import '../estilos/tokens.css';
import '../estilos/base.css';

interface Props { titulo: string; ancho?: 'texto' | 'total' }
const { titulo, ancho = 'total' } = Astro.props;

const v = P.version();
const bt = P.backtesting();

// `lista: false` = todavia no construida. Apagada, nunca un enlace roto.
const GRUPOS = [
  {
    grupo: 'Plan',
    items: [
      { href: '/', texto: 'Portada', lista: true },
      { href: '/plan', texto: 'Recorrido', lista: false },
      { href: '/reglas', texto: 'Reglas', lista: false, cuenta: P.reglas().length },
      { href: '/parametros', texto: 'Parámetros', lista: false, cuenta: P.parametros().size },
      { href: '/glosario', texto: 'Glosario', lista: false, cuenta: P.glosario().length },
    ],
  },
  {
    grupo: 'Práctica',
    items: [
      { href: '/checklist', texto: 'Checklist', lista: false },
      { href: '/galeria', texto: 'Galería', lista: false, cuenta: P.galeria().length },
    ],
  },
  {
    grupo: 'Abierto',
    items: [
      { href: '/pendientes', texto: 'Pendientes', lista: false, cuenta: P.pendientesAbiertos().length },
      { href: '/contextualizacion', texto: 'Contexto', lista: false },
      { href: '/cierre', texto: 'Cierre F1', lista: false },
    ],
  },
];

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const activa = (href: string) =>
  ruta === href.replace(/\/$/, '') || (href !== '/' && ruta.startsWith(href));
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Plan Chaumer</title>
  </head>

  <body class="sin-js">
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <!-- Cinta de estado. Como la cabecera de un terminal: solo datos. -->
    <div class="cinta">
      <span class="cinta-i"><b>PLAN</b> v{v.version}</span>
      <span class="cinta-i"><b>ACT</b> {v.fecha}</span>
      <span class="cinta-i"><b>REGLAS</b> {P.reglas().length}</span>
      <span class="cinta-i"><b>ESTADO</b> <em class="alerta">NO PROBADO</em></span>
      <a class="cinta-i cinta-a" href="/cierre">{bt.huecos.length} HUECOS DECLARADOS</a>
    </div>

    <div class="marco">
      <aside class="rail">
        <a class="marca" href="/">
          <span class="marca-n">CHAUMER</span>
          <span class="marca-s">NQ · MNQ · NT8</span>
        </a>

        <nav class="nav" aria-label="Secciones">
          {GRUPOS.map((g) => (
            <div class="nav-g">
              <p class="etiqueta nav-t">{g.grupo}</p>
              {g.items.map((s) => (
                s.lista
                  ? <a href={s.href} class:list={['nav-i', { activa: activa(s.href) }]}>
                      <span>{s.texto}</span>
                      {s.cuenta && <span class="nav-c">{String(s.cuenta).padStart(2, '0')}</span>}
                    </a>
                  : <span class="nav-i pendiente" aria-disabled="true">
                      <span>{s.texto}</span>
                      {s.cuenta && <span class="nav-c">{String(s.cuenta).padStart(2, '0')}</span>}
                    </span>
              ))}
            </div>
          ))}
        </nav>

        <a class="estado" href="/cierre"><span class="pastilla aviso">no probado</span></a>
      </aside>

      <div class="cuerpo">
        <main id="contenido" class:list={['contenido', ancho]}>
          <slot />
        </main>

        <footer class="pie">
          <p class="meta">
            Renderiza <code>01_Plan/</code>. No añade metodología, no manda
            órdenes, no se conecta a la cuenta. Una observación no modifica el plan.
          </p>
        </footer>
      </div>
    </div>

    <script is:inline>
      document.body.classList.remove('sin-js');
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var hayIO = 'IntersectionObserver' in window;

        // Entrada al aparecer. IntersectionObserver, nunca listener de scroll.
        var objetivos = document.querySelectorAll('.entra');
        if (!hayIO || reduce) {
          objetivos.forEach(function (e) { e.classList.add('visible'); });
        } else {
          var obs = new IntersectionObserver(function (filas) {
            filas.forEach(function (f) {
              if (!f.isIntersecting) return;
              f.target.classList.add('visible');
              obs.unobserve(f.target);
            });
          }, { rootMargin: '0px 0px -6% 0px', threshold: 0.05 });
          objetivos.forEach(function (e) { obs.observe(e); });
        }

        // Cifras que cuentan al entrar: detalle de terminal financiero.
        // El valor final ya esta en el HTML; esto solo lo anima.
        var cifras = document.querySelectorAll('[data-contar]');
        if (!cifras.length || reduce || !hayIO) return;
        var obs2 = new IntersectionObserver(function (filas) {
          filas.forEach(function (f) {
            if (!f.isIntersecting) return;
            obs2.unobserve(f.target);
            var fin = parseInt(f.target.getAttribute('data-contar'), 10);
            if (isNaN(fin)) return;
            var ini = performance.now(), dur = 700;
            requestAnimationFrame(function paso(t) {
              var k = Math.min(1, (t - ini) / dur);
              k = 1 - Math.pow(1 - k, 3);
              f.target.textContent = String(Math.round(fin * k));
              if (k < 1) requestAnimationFrame(paso);
              else f.target.textContent = String(fin);
            });
          });
        }, { threshold: 0.4 });
        cifras.forEach(function (e) { obs2.observe(e); });
      })();
    </script>

    <style>
      .saltar {
        position: fixed; left: var(--e-3); top: var(--e-3); z-index: 20;
        padding: var(--e-2) var(--e-3);
        background: var(--sup-3); box-shadow: none;
        transform: translateY(-250%);
      }
      .saltar:focus { transform: none; }

      /* ── cinta de estado ───────────────────────────────────────────── */
      .cinta {
        display: flex; flex-wrap: wrap; align-items: center;
        border-bottom: 1px solid var(--filete);
        font-family: var(--fuente-mono);
        font-size: var(--t-1);
        letter-spacing: var(--track-etiqueta);
        color: var(--texto-3);
        background: var(--sup-1);
      }
      .cinta-i {
        padding: var(--e-2) var(--e-4);
        border-right: 1px solid var(--filete-tenue);
        white-space: nowrap;
      }
      .cinta-i b { font-weight: var(--peso-medio); opacity: 0.6; margin-right: var(--e-2); }
      .cinta .alerta { font-style: normal; color: var(--oro); }
      .cinta-a {
        margin-left: auto; border-right: 0;
        border-left: 1px solid var(--filete-tenue);
        color: var(--oro); box-shadow: none;
      }
      .cinta-a:hover { background: var(--sup-3); color: var(--oro); box-shadow: none; }

      /* ── rail ──────────────────────────────────────────────────────── */
      .marco { display: grid; grid-template-columns: var(--rail) minmax(0, 1fr); min-height: 100dvh; }

      .rail {
        position: sticky; top: 0; align-self: start; height: 100dvh;
        display: flex; flex-direction: column; gap: var(--e-6);
        padding: var(--e-5) 0;
        border-right: 1px solid var(--filete);
        overflow-y: auto;
      }

      .marca { display: block; padding: 0 var(--e-5); box-shadow: none; }
      .marca:hover { box-shadow: none; }
      .marca-n {
        display: block; font-family: var(--fuente-mono);
        font-size: var(--t-3); font-weight: var(--peso-max);
        letter-spacing: var(--track-etiqueta); color: var(--texto);
      }
      .marca-s {
        display: block; font-family: var(--fuente-mono);
        font-size: var(--t-1); color: var(--texto-3);
        letter-spacing: var(--track-etiqueta); margin-top: var(--e-2);
      }

      .nav { display: flex; flex-direction: column; gap: var(--e-6); flex: 1; }
      .nav-g { display: flex; flex-direction: column; }
      .nav-t { margin: 0 0 var(--e-3); padding: 0 var(--e-5); opacity: 0.7; }

      .nav-i {
        display: flex; align-items: center; justify-content: space-between;
        gap: var(--e-3);
        padding: var(--e-2) var(--e-5);
        min-height: 2.125rem;
        font-size: var(--t-3);
        color: var(--texto-2);
        box-shadow: none;
        border-left: 2px solid transparent;
        transition: color var(--transicion), background var(--transicion), border-color var(--transicion);
      }
      .nav-i:hover { background: var(--sup-1); color: var(--texto); box-shadow: none; }
      .nav-i.activa {
        color: var(--texto); background: var(--sup-2);
        border-left-color: var(--azul);
        font-weight: var(--peso-medio);
      }
      /* Pendiente: opacidad Y cursor, nunca solo color. */
      .nav-i.pendiente { color: var(--texto-3); opacity: 0.45; cursor: not-allowed; }
      .nav-i.pendiente:hover { background: none; color: var(--texto-3); }
      .nav-c { font-family: var(--fuente-mono); font-size: var(--t-1); color: var(--texto-3); }

      .estado { padding: 0 var(--e-5); box-shadow: none; }
      .estado:hover { box-shadow: none; }

      /* ── contenido ─────────────────────────────────────────────────── */
      .cuerpo { display: flex; flex-direction: column; min-width: 0; }
      .contenido { flex: 1; width: 100%; padding: var(--e-8) var(--e-7) var(--e-9); }
      .contenido.texto { max-width: 56rem; }
      .contenido.total { max-width: var(--ancho-total); }

      .pie { border-top: 1px solid var(--filete); padding: var(--e-5) var(--e-7); }

      /* ── por debajo de 900px el rail pasa arriba ───────────────────── */
      @media (max-width: 900px) {
        .marco { grid-template-columns: 1fr; }
        .rail {
          position: static; height: auto;
          flex-direction: row; align-items: center; gap: var(--e-4);
          border-right: 0; border-bottom: 1px solid var(--filete);
          padding: var(--e-3) var(--e-4); overflow-x: auto;
        }
        .nav { flex-direction: row; gap: var(--e-4); flex: 0 0 auto; }
        .nav-g { flex-direction: row; }
        .nav-t { display: none; }
        .nav-i {
          white-space: nowrap; padding: var(--e-2) var(--e-3);
          border-left: 0; border-bottom: 2px solid transparent;
        }
        .nav-i.activa { border-left: 0; border-bottom-color: var(--azul); }
        .marca, .estado { flex: 0 0 auto; padding: 0 var(--e-2); }
        .marca-s { display: none; }
        .contenido { padding: var(--e-6) var(--e-4) var(--e-8); }
        .pie { padding: var(--e-5) var(--e-4); }
        .cinta-i { padding: var(--e-2) var(--e-3); }
      }
    </style>
  </body>
</html>
