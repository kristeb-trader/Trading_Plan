---
/**
 * Marco — barra lateral, contenido y aviso permanente.
 *
 * ESCRITORIO PRIMERO: barra lateral fija a la izquierda. Diez secciones no
 * caben comodas en una fila de pestanas, y el portal se usa en computador.
 * Por debajo de 900px la barra pasa arriba y se desplaza en horizontal.
 *
 * El aviso de «no probado» lo pone el marco, no la pagina: asi ninguna
 * pantalla puede esconderlo. Va en oro, no en rojo — es una advertencia sobre
 * el estado del plan, no un error. El rojo queda reservado para un dato
 * negativo de verdad.
 */
import * as P from '../lib/parsers.mjs';
import '../estilos/tokens.css';
import '../estilos/base.css';

interface Props { titulo: string; ancho?: 'texto' | 'total' }
const { titulo, ancho = 'texto' } = Astro.props;

const v = P.version();
const bt = P.backtesting();

// `lista: false` = todavia no construida. Se muestra apagada, no como enlace roto.
const GRUPOS = [
  {
    grupo: 'El plan',
    items: [
      { href: '/', texto: 'Portada', lista: true },
      { href: '/plan', texto: 'Recorrido completo', lista: false },
      { href: '/reglas', texto: 'Reglas', lista: false, cuenta: P.reglas().length },
      { href: '/parametros', texto: 'Parámetros', lista: false, cuenta: P.parametros().size },
      { href: '/glosario', texto: 'Glosario', lista: false, cuenta: P.glosario().length },
    ],
  },
  {
    grupo: 'Práctica',
    items: [
      { href: '/checklist', texto: 'Checklist diaria', lista: false },
      { href: '/galeria', texto: 'Galería de casos', lista: false, cuenta: P.galeria().length },
    ],
  },
  {
    grupo: 'Lo que falta',
    items: [
      { href: '/pendientes', texto: 'Pendientes', lista: false, cuenta: P.pendientesAbiertos().length },
      { href: '/contextualizacion', texto: 'Contextualización', lista: false },
      { href: '/cierre', texto: 'Cierre de la fase 1', lista: false },
    ],
  },
];

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const activa = (href: string) =>
  ruta === href.replace(/\/$/, '') || (href !== '/' && ruta.startsWith(href));
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Plan Chaumer</title>
  </head>

  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <div class="marco">
      <aside class="rail">
        <a class="marca" href="/">
          <span class="marca-n">Plan Chaumer</span>
          <span class="marca-s">NQ · MNQ · NinjaTrader 8</span>
        </a>

        <nav class="nav" aria-label="Secciones">
          {GRUPOS.map((g) => (
            <div class="nav-g">
              <p class="etiqueta nav-t">{g.grupo}</p>
              {g.items.map((s) => (
                s.lista
                  ? <a href={s.href} class:list={['nav-i', { activa: activa(s.href) }]}>
                      <span>{s.texto}</span>
                      {s.cuenta && <span class="nav-c num">{s.cuenta}</span>}
                    </a>
                  : <span class="nav-i pendiente" aria-disabled="true">
                      <span>{s.texto}</span>
                      {s.cuenta && <span class="nav-c num">{s.cuenta}</span>}
                    </span>
              ))}
            </div>
          ))}
        </nav>

        <a class="estado" href="/cierre">
          <span class="pastilla aviso">plan no probado</span>
          <span class="estado-d meta">
            v{v.version} · {bt.huecos.length} huecos declarados
          </span>
        </a>
      </aside>

      <div class="cuerpo">
        <main id="contenido" class:list={['contenido', ancho]}>
          <slot />
        </main>

        <footer class="pie">
          <p class="meta">
            El portal renderiza <code>01_Plan/</code>. No añade metodología, no
            manda órdenes y no se conecta a la cuenta. Una observación no
            modifica el plan.
          </p>
        </footer>
      </div>
    </div>

    <style>
      .saltar {
        position: fixed; left: var(--e-3); top: var(--e-3); z-index: 10;
        padding: var(--e-2) var(--e-3);
        background: var(--sup-3); border: 1px solid var(--hilo);
        border-radius: var(--radio-1);
        transform: translateY(-250%);
      }
      .saltar:focus { transform: none; }

      .marco { display: grid; grid-template-columns: var(--rail) 1fr; min-height: 100dvh; }

      /* ── barra lateral ─────────────────────────────────────────────── */
      .rail {
        position: sticky; top: 0; align-self: start;
        height: 100dvh;
        display: flex; flex-direction: column; gap: var(--e-5);
        padding: var(--e-5) var(--e-4);
        background: color-mix(in srgb, var(--sup-1) 82%, transparent);
        backdrop-filter: blur(12px);
        border-right: 1px solid var(--hilo);
        overflow-y: auto;
      }

      .marca { display: block; border: 0; }
      .marca:hover { color: inherit; }
      .marca-n {
        display: block; font-size: var(--t-4); font-weight: var(--peso-max);
        letter-spacing: var(--track-titulo); color: var(--texto);
      }
      .marca-s {
        display: block; font-size: var(--t-1); color: var(--texto-3);
        font-family: var(--fuente-mono); margin-top: var(--e-1);
      }

      .nav { display: flex; flex-direction: column; gap: var(--e-5); flex: 1; }
      .nav-g { display: flex; flex-direction: column; gap: 1px; }
      .nav-t { margin: 0 0 var(--e-2); padding-left: var(--e-3); }

      .nav-i {
        display: flex; align-items: center; justify-content: space-between;
        gap: var(--e-2);
        padding: var(--e-2) var(--e-3);
        min-height: 2.25rem;
        border: 0; border-radius: var(--radio-2);
        font-size: var(--t-3);
        color: var(--texto-2);
        transition: background var(--transicion), color var(--transicion);
      }
      .nav-i:hover { background: var(--sup-3); color: var(--texto); }
      .nav-i.activa {
        background: color-mix(in srgb, var(--azul) 14%, transparent);
        color: var(--texto);
        font-weight: var(--peso-medio);
        box-shadow: inset 2px 0 0 var(--azul);
      }
      /* Pendiente: se distingue por opacidad y por el cursor, no solo por color. */
      .nav-i.pendiente { color: var(--texto-3); opacity: 0.5; cursor: not-allowed; }
      .nav-i.pendiente:hover { background: none; color: var(--texto-3); }

      .nav-c {
        font-size: var(--t-1); color: var(--texto-3);
        background: var(--sup-3); border-radius: var(--radio-pill);
        padding: 0 var(--e-2); min-width: 1.5rem; text-align: center;
      }

      .estado { display: block; border: 0; }
      .estado:hover { color: inherit; }
      .estado:hover .pastilla { border-color: var(--oro); }
      .estado-d { display: block; margin-top: var(--e-2); padding-left: var(--e-1); }

      /* ── contenido ─────────────────────────────────────────────────── */
      .cuerpo { display: flex; flex-direction: column; min-width: 0; }
      .contenido {
        flex: 1; width: 100%; margin: 0 auto;
        padding: var(--e-7) var(--e-6) var(--e-8);
      }
      .contenido.texto { max-width: var(--ancho-texto); }
      .contenido.total { max-width: var(--ancho-total); }

      .pie { border-top: 1px solid var(--hilo); padding: var(--e-4) var(--e-6); }
      .pie p { max-width: var(--ancho-total); margin: 0 auto; }

      /* ── por debajo de 900px la barra pasa arriba ──────────────────── */
      @media (max-width: 900px) {
        .marco { grid-template-columns: 1fr; }
        .rail {
          position: static; height: auto;
          flex-direction: row; align-items: center; gap: var(--e-4);
          border-right: 0; border-bottom: 1px solid var(--hilo);
          padding: var(--e-3) var(--e-4);
          overflow-x: auto;
        }
        .nav { flex-direction: row; gap: var(--e-3); flex: 0 0 auto; }
        .nav-g { flex-direction: row; gap: var(--e-1); }
        .nav-t { display: none; }
        .nav-i { white-space: nowrap; }
        .nav-i.activa { box-shadow: none; }
        .marca-s, .estado-d { display: none; }
        .marca, .estado { flex: 0 0 auto; }
        .contenido { padding: var(--e-6) var(--e-4) var(--e-7); }
        .pie { padding: var(--e-4); }
      }
    </style>
  </body>
</html>
