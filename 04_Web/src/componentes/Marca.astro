---
/**
 * Marca — el icono y el nombre del portal, arriba a la izquierda.
 *
 * El icono NO es un simbolo generico de bolsa. Es el zigzag con el que este
 * plan marca corridas y retrocesos: sube, corrige, vuelve a subir. Es el
 * unico dibujo del portal que sale del vocabulario del metodo.
 *
 * El mismo dibujo esta en public/favicon.svg para la pestana del navegador.
 * Alli los colores van literales porque un archivo .svg suelto no ve los
 * tokens de la pagina; aqui, al ir en linea, si los hereda.
 */
---

<a class="marca" href="/" aria-label="Trading Plan Nasdaq, ir al inicio">
  <span class="marca-i" aria-hidden="true">
    <svg viewBox="0 0 32 32" fill="none">
      <rect class="m-tile" width="32" height="32" rx="9" />
      <path class="m-zig" d="M7 23.5 L12.5 13 L16.5 17.5 L21.5 8" />
      <circle class="m-pt" cx="21.5" cy="8" r="2.6" />
    </svg>
  </span>
  <span class="marca-n">
    Trading Plan <span class="marca-a">Nasdaq</span>
  </span>
</a>

<style>
  .marca {
    display: inline-flex; align-items: center; gap: var(--e-3);
    /* 44px de alto util: en el movil es un objetivo tactil, no solo texto. */
    min-height: 2.75rem;
    color: var(--texto);
  }
  .marca:hover { color: var(--texto); }

  .marca-i { display: block; width: 2rem; height: 2rem; flex: none; }
  .marca-i svg { width: 100%; height: 100%; display: block; }

  /* El azulejo lleva el degradado de marca y una sombra desplazada: es la
     unica pieza de la cabecera con volumen propio. */
  .m-tile {
    fill: var(--acento);
    filter: drop-shadow(0 3px 8px color-mix(in srgb, var(--acento) 45%, transparent));
  }
  .m-zig {
    stroke: var(--n-50);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .m-pt { fill: var(--n-50); }

  .marca-n {
    font-size: var(--t-4);
    font-weight: var(--peso-fuerte);
    letter-spacing: var(--track-titulo);
    white-space: nowrap;
  }
  .marca-a { color: var(--acento); }

  /* Al pasar el raton el azulejo se aclara: confirma que es un enlace sin
     subrayar ni mover nada. */
  .marca:hover .m-tile { fill: var(--acento-vivo); }
  .m-tile, .marca-a { transition: fill var(--normal), color var(--normal); }

  @media (max-width: 900px) {
    .marca-i { width: 1.75rem; height: 1.75rem; }
    .marca-n { font-size: var(--t-3); }
  }
</style>
