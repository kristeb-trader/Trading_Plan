---
/**
 * Modulo — la envoltura de cada uno de los ocho pasos del metodo.
 *
 * Pone lo que se repite en los ocho: la portada con su numero, la barra de
 * progreso del recorrido, el indice lateral que sigue al scroll y el pie que
 * lleva al siguiente. La pagina solo escribe su contenido.
 *
 * El indice se declara a mano en cada pagina (no se deduce del HTML) porque
 * asi la pagina decide que apartados merecen entrada y cuales no.
 */
import Marco from './Marco.astro';
import Icono from './Icono.astro';
import { MODULOS, modulo, vecinos } from '../lib/modulos.mjs';

interface Props {
  slug: string;
  secciones?: { id: string; t: string }[];
}
const { slug, secciones = [] } = Astro.props;

const m = modulo(slug);
const { anterior, siguiente } = vecinos(slug);
const dos = (n: number) => String(n).padStart(2, '0');
---

<Marco titulo={m.titulo}>
  <!-- ── barra de progreso del recorrido ──────────────────────────────── -->
  <nav class="pasos" aria-label="Los ocho módulos">
    {MODULOS.map((x) => (
      <a
        href={`/${x.slug}`}
        class:list={['paso-p', { aqui: x.slug === slug, hecho: x.n < m.n }]}
        title={`${dos(x.n)} · ${x.titulo}`}
        aria-current={x.slug === slug ? 'page' : undefined}
      >
        <span class="pp-n num">{dos(x.n)}</span>
        <span class="pp-t">{x.corto}</span>
      </a>
    ))}
  </nav>

  <div class="mod">
    <div class="mod-cuerpo">
      <header class="mod-cab entra">
        <span class="mod-n num">{dos(m.n)}</span>
        <h1>{m.titulo}</h1>
        <p class="lead">{m.sub}</p>
      </header>

      <slot />

      <!-- ── siguiente paso ──────────────────────────────────────────── -->
      <nav class="mod-pie entra" aria-label="Continuar">
        {anterior ? (
          <a class="mp mp-a" href={`/${anterior.slug}`}>
            <Icono nombre="arrow-left" />
            <span>
              <span class="mp-e meta">Anterior</span>
              <span class="mp-t">{anterior.titulo}</span>
            </span>
          </a>
        ) : (
          <a class="mp mp-a" href="/">
            <Icono nombre="arrow-left" />
            <span>
              <span class="mp-e meta">Volver</span>
              <span class="mp-t">Inicio</span>
            </span>
          </a>
        )}

        {siguiente ? (
          <a class="mp mp-s" href={`/${siguiente.slug}`}>
            <span>
              <span class="mp-e meta">Siguiente</span>
              <span class="mp-t">{siguiente.titulo}</span>
            </span>
            <Icono nombre="arrow-right" />
          </a>
        ) : (
          <a class="mp mp-s" href="/galeria">
            <span>
              <span class="mp-e meta">Y para terminar</span>
              <span class="mp-t">Los casos reales</span>
            </span>
            <Icono nombre="arrow-right" />
          </a>
        )}
      </nav>
    </div>

    <!-- ── indice del modulo ─────────────────────────────────────────── -->
    {secciones.length > 0 && (
      <aside class="mod-idx" aria-label="En esta sección">
        <div class="mi-in">
          <p class="etiqueta mi-t">En esta sección</p>
          <ol class="mi-l">
            {secciones.map((s) => (
              <li><a href={`#${s.id}`} data-idx={s.id}>{s.t}</a></li>
            ))}
          </ol>
        </div>
      </aside>
    )}
  </div>
</Marco>

<script is:inline>
  // El indice sigue al scroll: se resalta el apartado que se esta leyendo.
  // Con un observador, no con un calculo en cada pixel de scroll.
  (function () {
    var enlaces = Array.prototype.slice.call(document.querySelectorAll('[data-idx]'));
    if (!enlaces.length || !('IntersectionObserver' in window)) return;

    var porId = {};
    enlaces.forEach(function (a) { porId[a.getAttribute('data-idx')] = a; });

    var visibles = {};
    var obs = new IntersectionObserver(
      function (entradas) {
        entradas.forEach(function (e) { visibles[e.target.id] = e.isIntersecting; });
        var activo = null;
        for (var i = 0; i < enlaces.length; i++) {
          var id = enlaces[i].getAttribute('data-idx');
          if (visibles[id]) { activo = id; break; }
        }
        enlaces.forEach(function (a) {
          a.classList.toggle('aqui', a.getAttribute('data-idx') === activo);
        });
      },
      // Se considera «leyendo» la franja alta de la ventana, no el centro:
      // es donde estan los ojos cuando se baja poco a poco.
      { rootMargin: '-80px 0px -65% 0px', threshold: 0 }
    );

    Object.keys(porId).forEach(function (id) {
      var el = document.getElementById(id);
      if (el) obs.observe(el);
    });
  })();
</script>

<style>
  /* ── barra de progreso ─────────────────────────────────────────────── */
  .pasos {
    display: flex;
    gap: 2px;
    margin-bottom: var(--e-7);
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: var(--e-1);
  }
  .pasos::-webkit-scrollbar { display: none; }

  .paso-p {
    flex: 1 1 0;
    min-width: 5.5rem;
    display: grid;
    gap: 2px;
    padding: var(--e-2) var(--e-3) var(--e-3);
    border-top: 2px solid var(--borde-sutil);
    color: var(--texto-3);
    transition: border-color var(--normal), color var(--normal), background var(--normal);
  }
  .paso-p:hover { color: var(--texto); background: rgba(255, 255, 255, 0.025); }
  .paso-p.hecho { border-top-color: var(--n-600); color: var(--texto-3); }
  .paso-p.aqui {
    border-top-color: var(--acento);
    color: var(--texto);
    background: rgba(255, 255, 255, 0.03);
  }
  .pp-n { font-size: var(--t-1); letter-spacing: var(--track-cifra); opacity: 0.7; }
  .paso-p.aqui .pp-n { color: var(--acento); opacity: 1; }
  .pp-t {
    font-size: var(--t-1);
    line-height: 1.25;
    /* Dos lineas como maximo: los titulos largos no descuadran la barra. */
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── reparto ───────────────────────────────────────────────────────── */
  .mod { display: grid; grid-template-columns: minmax(0, 1fr) 13rem; gap: var(--e-8); }
  .mod-cuerpo { min-width: 0; }

  /* ── portada del modulo ────────────────────────────────────────────── */
  .mod-cab { margin-bottom: var(--e-8); }
  .mod-n {
    display: block;
    font-size: var(--t-2);
    letter-spacing: var(--track-cifra);
    color: var(--acento);
    margin-bottom: var(--e-2);
  }
  .mod-cab h1 { margin: 0 0 var(--e-4); font-size: clamp(var(--t-7), 3vw, 2.4rem); }
  .mod-cab .lead { font-size: var(--t-5); color: var(--texto-2); max-width: 48ch; margin: 0; }

  /* ── indice lateral ────────────────────────────────────────────────── */
  .mod-idx { position: relative; }
  .mi-in { position: sticky; top: var(--e-6); }
  .mi-t { margin: 0 0 var(--e-3); }
  .mi-l { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; max-width: none; }
  .mi-l li { margin: 0; }
  .mi-l a {
    display: block;
    padding: var(--e-2) var(--e-3);
    border-left: 2px solid var(--borde-sutil);
    font-size: var(--t-2);
    line-height: 1.3;
    color: var(--texto-3);
    transition: color var(--normal), border-color var(--normal);
  }
  .mi-l a:hover { color: var(--texto-2); border-left-color: var(--n-600); }
  .mi-l a.aqui { color: var(--texto); border-left-color: var(--acento); }

  /* ── pie ───────────────────────────────────────────────────────────── */
  .mod-pie {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-3);
    margin-top: var(--e-9);
    padding-top: var(--e-6);
    border-top: 1px solid var(--borde-sutil);
  }
  .mp {
    display: flex; align-items: center; gap: var(--e-3);
    padding: var(--e-4) var(--e-5);
    border: 1px solid var(--vidrio-borde);
    border-radius: var(--radio-3);
    background: var(--vidrio-fondo);
    color: var(--texto-2);
    transition: border-color var(--normal), background var(--normal), color var(--normal);
  }
  .mp:hover { border-color: var(--n-600); background: rgba(255, 255, 255, 0.05); color: var(--texto); }
  .mp-s { justify-content: flex-end; text-align: right; }
  .mp-e { display: block; }
  .mp-t { display: block; font-size: var(--t-3); font-weight: var(--peso-medio); }

  @media (max-width: 1200px) {
    .mod { grid-template-columns: 1fr; }
    .mod-idx { display: none; }
  }
  @media (max-width: 700px) {
    .mod-pie { grid-template-columns: 1fr; }
    .mp-s { justify-content: flex-start; text-align: left; flex-direction: row-reverse; }
  }
</style>
