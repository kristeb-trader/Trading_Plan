---
/**
 * Acta de cierre de la fase 1.
 *
 * Se renderiza el documento entero, incluida la tabla del backtesting. Y
 * eso obliga a lo de siempre: la cifra NO puede aparecer sola. Aqui aparece
 * dentro del propio acta, que es justo el documento que explica por que no
 * vale, asi que los motivos estan en la misma pantalla por construccion.
 * Aun asi se destacan arriba, para que nadie llegue a la tabla sin haberlos
 * leido.
 */
import Marco from '../componentes/Marco.astro';
import * as P from '../lib/parsers.mjs';

const bt = P.backtesting();
const v = P.version();
const html = P.markdownRico(P.documentoCierre());
---

<Marco titulo="Acta de cierre" ancho="texto">
  <header class="cab entra">
    <h1>Acta de cierre de la fase 1</h1>
    <p class="lead">
      Qué quedó probado y qué no, escrito el día que se cerró. Es el documento
      al que apunta el aviso de «no probado» que ves en todas las páginas.
    </p>
  </header>

  <!-- La cifra y sus motivos, arriba del todo. El acta los repite mas abajo
       con todo el detalle; esto es para que nadie llegue a la tabla sin
       haberlos visto. -->
  <section class="destacado entra">
    <div class="d-cifra">
      <span class="etiqueta">Resultado del backtesting</span>
      <span class="d-n num">{bt.total}</span>
      <span class="meta">{bt.operaciones} operaciones en 11 sesiones</span>
    </div>
    <div class="d-txt">
      <p class="d-t">Esta cifra no mide la estrategia.</p>
      <p class="apunte">
        Nueve operaciones no dicen nada estadísticamente, las reglas cambiaron
        durante la propia revisión, no hubo filtro de noticias rojas y falta la
        capa de contexto. El acta lo desarrolla más abajo.
      </p>
    </div>
  </section>

  <article class="md acta entra" set:html={html} />

  <p class="pie-nota meta">Plan v{v.version}, actualizado el {v.fecha}.</p>
</Marco>

<style>
  .cab { margin-bottom: var(--e-6); }
  .lead { font-size: var(--t-5); color: var(--texto-2); margin: var(--e-4) 0 0; }

  .destacado {
    display: grid; grid-template-columns: minmax(11rem, 15rem) minmax(0, 1fr);
    gap: var(--e-6);
    padding: var(--e-5) var(--e-6);
    margin-bottom: var(--e-8);
    border-radius: var(--radio-3);
    background: var(--vidrio-fondo);
    border: 1px solid color-mix(in srgb, var(--negativo) 26%, transparent);
  }
  .d-cifra { display: flex; flex-direction: column; gap: var(--e-1); }
  .d-n {
    font-size: var(--t-9); font-weight: var(--peso-max);
    color: var(--negativo); line-height: 1;
    letter-spacing: var(--track-cifra); margin: var(--e-2) 0;
  }
  .d-t { margin: 0 0 var(--e-3); font-size: var(--t-5); font-weight: var(--peso-fuerte); color: var(--aviso); }

  /* El acta trae sus propios encabezados: se les da aire para que el
     documento se lea como documento. */
  .acta :global(h1) { display: none; } /* el titulo ya lo pone la pagina */
  .acta :global(h2) { margin-top: var(--e-8); padding-top: var(--e-5); border-top: 1px solid var(--borde-sutil); }
  .acta :global(h3) { margin-top: var(--e-6); }
  .acta :global(pre) {
    padding: var(--e-4); border-radius: var(--radio-2);
    background: var(--superficie); overflow-x: auto;
    font-size: var(--t-2); line-height: 1.5;
  }

  .pie-nota { margin-top: var(--e-8); }

  @media (max-width: 760px) {
    .destacado { grid-template-columns: 1fr; gap: var(--e-4); padding: var(--e-5); }
  }
</style>
