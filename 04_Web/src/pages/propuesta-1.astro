---
/**
 * PROPUESTA 1 — Editorial.
 *
 * Direccion: «Minimalism & Swiss Style» (ui-ux-pro-max, variance 2, density 3).
 * Tipografia grande, rejilla estricta, filetes de un pixel y mucho aire. Cero
 * tarjetas: la jerarquia la hacen el tamano, el peso y el espacio en blanco.
 *
 * Se lee como un documento impreso. Es la opcion mas seria de las tres y la
 * que mejor le sienta a un metodo que presume de no tener adjetivos.
 *
 * Temporal: se borra cuando el operador elija una de las tres.
 */
import Marco from '../componentes/Marco.astro';
import Propuestas from '../componentes/Propuestas.astro';
import Icono from '../componentes/Icono.astro';
import { MODULOS } from '../lib/modulos.mjs';
import * as P from '../lib/parsers.mjs';

const galeria = P.galeria();
const heroe = galeria.find((c) => c.id === 'G-16')?.imagen;
const dos = (n) => String(n).padStart(2, '0');
---

<Marco titulo="Propuesta 1 · Editorial">
  <Propuestas activa={1} />

  <!-- ── titular a toda la columna ──────────────────────────────────── -->
  <header class="ed-cab">
    <p class="ed-sup">El método de Alfredo Chaumer</p>
    <h1>Ocho pasos.<br />Ninguna opinión.</h1>
    <p class="ed-lead">
      Un método de trading para NQ y MNQ, traducido a reglas que se pueden
      medir, seguir y operar.
    </p>
  </header>

  <!-- ── el gráfico, a sangre por la derecha ────────────────────────── -->
  <figure class="ed-gr">
    <img src={heroe} width="2000" height="1060" decoding="async" loading="eager"
         alt="Una sesión real con las zonas marcadas y la operación" />
    <figcaption>
      <span class="ed-fc-n num">13.07.2026</span>
      Una sesión completa, marcada con el método.
    </figcaption>
  </figure>

  <!-- ── los ocho, como índice de libro ─────────────────────────────── -->
  <section class="ed-idx" aria-label="Los ocho módulos">
    <h2 class="ed-h2">El recorrido</h2>
    <ol class="ed-l">
      {MODULOS.map((m) => (
        <li>
          <a href={`/${m.slug}`}>
            <span class="ed-n num">{dos(m.n)}</span>
            <span class="ed-t">{m.titulo}</span>
            <span class="ed-s">{m.sub}</span>
            <span class="ed-fl" aria-hidden="true"><Icono nombre="arrow-right" /></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="ed-pie">
    <a class="ed-cta" href="/premercado">
      Empezar por el principio <Icono nombre="arrow-right" />
    </a>
    <a class="ed-alt" href="/galeria">o mira {galeria.length} sesiones reales</a>
  </section>
</Marco>

<style>
  /* ── cabecera ─────────────────────────────────────────────────────── */
  .ed-cab {
    padding-bottom: var(--e-7);
    border-bottom: 1px solid var(--borde-sutil);
    margin-bottom: var(--e-7);
  }
  .ed-sup {
    margin: 0 0 var(--e-4);
    font-size: var(--t-2);
    letter-spacing: var(--track-etiqueta);
    text-transform: uppercase;
    color: var(--texto-3);
  }
  .ed-cab h1 {
    margin: 0 0 var(--e-5);
    font-size: clamp(var(--t-9), 6vw, 4.75rem);
    font-weight: var(--peso-max);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .ed-lead {
    margin: 0; max-width: 46ch;
    font-size: var(--t-5); color: var(--texto-2);
  }

  /* ── gráfico ──────────────────────────────────────────────────────── */
  .ed-gr { margin: 0 0 var(--e-8); }
  .ed-gr img {
    width: 100%; height: auto; display: block;
    border-radius: var(--radio-2);
    border: 1px solid var(--borde-sutil);
  }
  .ed-gr figcaption {
    display: flex; align-items: baseline; gap: var(--e-3);
    margin-top: var(--e-3);
    font-size: var(--t-2); color: var(--texto-3);
  }
  .ed-fc-n { color: var(--texto-2); letter-spacing: var(--track-cifra); }

  /* ── índice ───────────────────────────────────────────────────────── */
  .ed-h2 {
    margin: 0 0 var(--e-4);
    font-size: var(--t-2);
    letter-spacing: var(--track-etiqueta);
    text-transform: uppercase;
    color: var(--texto-3);
    font-weight: var(--peso-medio);
  }
  .ed-l { list-style: none; margin: 0 0 var(--e-8); padding: 0; max-width: none; }
  .ed-l li { margin: 0; border-top: 1px solid var(--borde-sutil); }
  .ed-l li:last-child { border-bottom: 1px solid var(--borde-sutil); }

  /* Cada fila es una linea de indice: numero, titulo, descripcion. Sin caja
     y sin fondo. Al pasar por encima solo se desplaza y se aclara. */
  .ed-l a {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 15rem) minmax(0, 1fr) auto;
    align-items: baseline; gap: var(--e-4);
    padding: var(--e-5) var(--e-3);
    color: var(--texto-2);
    transition: background var(--normal), transform var(--normal), color var(--normal);
  }
  .ed-l a:hover { background: var(--vidrio-fondo); transform: translateX(4px); color: var(--texto); }
  .ed-n { font-size: var(--t-3); color: var(--texto-3); letter-spacing: var(--track-cifra); }
  .ed-l a:hover .ed-n { color: var(--acento); }
  .ed-t { font-size: var(--t-6); font-weight: var(--peso-fuerte); color: var(--texto); letter-spacing: var(--track-titulo); }
  .ed-s { font-size: var(--t-3); color: var(--texto-3); }
  .ed-fl { align-self: center; color: var(--texto-3); opacity: 0; transition: opacity var(--normal); }
  .ed-l a:hover .ed-fl { opacity: 1; color: var(--acento); }

  /* ── pie ──────────────────────────────────────────────────────────── */
  .ed-pie { display: flex; align-items: center; flex-wrap: wrap; gap: var(--e-5); }
  .ed-cta {
    display: inline-flex; align-items: center; gap: var(--e-2);
    min-height: var(--alto-control);
    padding: var(--e-3) var(--e-6);
    border-radius: var(--radio-pill);
    background: var(--texto); color: var(--n-950);
    font-size: var(--t-3); font-weight: var(--peso-fuerte);
    transition: background var(--normal);
  }
  .ed-cta:hover { background: #FFFFFF; color: var(--n-950); }
  .ed-cta:focus-visible { outline-color: var(--acento); }
  .ed-alt { font-size: var(--t-3); color: var(--texto-3); }
  .ed-alt:hover { color: var(--texto); }

  @media (max-width: 900px) {
    .ed-l a { grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--e-2) var(--e-3); padding: var(--e-4) var(--e-2); }
    .ed-s { grid-column: 2; }
    .ed-fl { display: none; }
  }
</style>
