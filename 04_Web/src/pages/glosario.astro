---
/**
 * Glosario.
 *
 * 23 encabezados de termino. La cabecera del documento y otros papeles del
 * proyecto dicen 24: rompimiento y consecucion comparten un solo encabezado
 * siendo dos terminos. Aqui sale el numero real, contado del archivo, y el
 * desajuste se explica en pantalla en vez de corregir el documento.
 */
import Marco from '../componentes/Marco.astro';
import Icono from '../componentes/Icono.astro';
import * as P from '../lib/parsers.mjs';

const terminos = P.glosario().map((t) => ({
  ...t,
  ancla: t.termino.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
  html: P.markdownRico(t.cuerpo),
}));
---

<Marco titulo="Glosario">
  <div class="disposicion">
    <div class="principal">
      <header class="cab entra">
        <h1>El vocabulario, {terminos.length} términos</h1>
        <p class="lead">
          Cada uno con una definición que se puede <strong>medir</strong>, no
          describir. Es lo que permite que las reglas no dependan de adjetivos.
        </p>
      </header>

      {terminos.map((t, i) => (
        <article class="termino entra" id={t.ancla} data-obs-tipo="termino" data-obs-id={t.termino} data-obs-titulo={t.termino} style={`--retraso:${Math.min(i, 8) * 30}ms`}>
          <header class="t-cab">
            <h2 class="t-t">{t.termino}</h2>
            <a class="t-enlace" href={`#${t.ancla}`} aria-label={`Enlace a ${t.termino}`}>
              <Icono nombre="link-simple" />
            </a>
          </header>
          <div class="md" set:html={t.html} />
        </article>
      ))}
    </div>

    <!-- Indice lateral: 23 terminos son muchos para recorrerlos a ciegas. -->
    <aside class="indice">
      <p class="etiqueta">En esta página</p>
      <nav aria-label="Índice de términos">
        {terminos.map((t) => (
          <a class="i-i" href={`#${t.ancla}`} data-ancla={t.ancla}>{t.termino}</a>
        ))}
      </nav>
    </aside>
  </div>
</Marco>

<script is:inline>
  // Resalta en el indice el termino que se esta leyendo.
  (function () {
    var items = document.querySelectorAll('[data-ancla]');
    var arts = document.querySelectorAll('.termino');
    if (!items.length || !('IntersectionObserver' in window)) return;
    var mapa = {};
    items.forEach(function (i) { mapa[i.getAttribute('data-ancla')] = i; });
    var obs = new IntersectionObserver(function (filas) {
      filas.forEach(function (f) {
        var el = mapa[f.target.id];
        if (!el) return;
        if (f.isIntersecting) {
          items.forEach(function (i) { i.classList.remove('activa'); });
          el.classList.add('activa');
        }
      });
    }, { rootMargin: '-10% 0px -70% 0px', threshold: 0 });
    arts.forEach(function (a) { obs.observe(a); });
  })();
</script>

<style>
  .disposicion { display: grid; grid-template-columns: minmax(0, 1fr) 14rem; gap: var(--e-8); }
  .principal { min-width: 0; }

  .cab { margin-bottom: var(--e-8); }
  .lead { font-size: var(--t-5); color: var(--texto-2); margin: var(--e-4) 0 var(--e-4); }

  .termino {
    padding: var(--e-6) 0;
    border-top: 1px solid var(--borde-sutil);
    scroll-margin-top: 6rem;
  }
  .termino:first-of-type { border-top: 0; }
  .t-cab { display: flex; align-items: center; gap: var(--e-3); margin-bottom: var(--e-4); }
  .t-t {
    margin: 0; font-size: var(--t-6);
    color: var(--info); letter-spacing: var(--track-titulo);
  }
  .t-enlace { color: var(--texto-3); --i: 0.9rem; display: flex; opacity: 0; transition: opacity var(--normal); }
  .termino:hover .t-enlace, .t-enlace:focus-visible { opacity: 1; }
  .termino:target .t-t { color: var(--acento); }

  /* ── indice lateral ──────────────────────────────────────────────────── */
  .indice {
    position: sticky; top: 5rem; align-self: start;
    max-height: calc(100dvh - 8rem); overflow-y: auto;
    padding-left: var(--e-4);
    border-left: 1px solid var(--borde-sutil);
  }
  .indice nav { display: flex; flex-direction: column; margin-top: var(--e-3); }
  .i-i {
    padding: var(--e-1) 0;
    font-size: var(--t-2); color: var(--texto-3);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    transition: color var(--rapido), padding-left var(--rapido);
  }
  .i-i:hover { color: var(--texto-2); }
  .i-i.activa { color: var(--acento); }

  @media (max-width: 1000px) {
    .disposicion { grid-template-columns: 1fr; gap: var(--e-6); }
    .indice { position: static; max-height: none; border-left: 0; padding-left: 0; order: -1;
              padding-bottom: var(--e-4); border-bottom: 1px solid var(--borde-sutil); }
    .indice nav { flex-direction: row; flex-wrap: wrap; gap: var(--e-3); }
  }
</style>
