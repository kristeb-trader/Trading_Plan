---
/**
 * PROPUESTA 3 — Bento.
 *
 * Direccion: mosaico asimetrico (ui-ux-pro-max, variance 8, density 6).
 * Piezas de tamanos distintos en una rejilla: la grande es el grafico, y
 * alrededor van el titular, los accesos y los ocho modulos.
 *
 * Es la mas «producto» de las tres: se ve todo de un vistazo y sin scroll.
 * Tambien es la que mas se parece a lo que hoy se lleva, con lo bueno y lo
 * malo que eso tiene.
 *
 * Temporal: se borra cuando el operador elija una de las tres.
 */
import Marco from '../componentes/Marco.astro';
import Propuestas from '../componentes/Propuestas.astro';
import Icono from '../componentes/Icono.astro';
import { MODULOS } from '../lib/modulos.mjs';
import * as P from '../lib/parsers.mjs';

const galeria = P.galeria();
const reglas = P.reglas();
const heroe = galeria.find((c) => c.id === 'G-16')?.imagen;
const dos = (n) => String(n).padStart(2, '0');
---

<Marco titulo="Propuesta 3 · Bento">
  <Propuestas activa={3} />

  <div class="bt">
    <!-- ── pieza grande: el titular ─────────────────────────────────── -->
    <section class="bt-p bt-tit">
      <h1>
        El método de<br />
        <span class="bt-nom">Alfredo Chaumer</span>,<br />
        en ocho pasos.
      </h1>
      <p>Reglas que se pueden medir, seguir y operar. Sin adjetivos.</p>
      <a class="bt-cta" href="/premercado">
        Empezar por el principio <Icono nombre="arrow-right" />
      </a>
    </section>

    <!-- ── pieza grande: el gráfico ─────────────────────────────────── -->
    <figure class="bt-p bt-gr">
      <img src={heroe} width="2000" height="1060" decoding="async" loading="eager"
           alt="Una sesión real con las zonas marcadas y la operación" />
      <figcaption>
        <span class="num">13.07.2026</span> · una sesión completa, marcada con el método
      </figcaption>
    </figure>

    <!-- ── piezas pequeñas: los accesos ─────────────────────────────── -->
    <a class="bt-p bt-mini" href="/galeria">
      <span class="bt-m-n num">{galeria.length}</span>
      <span class="bt-m-t">sesiones reales<br />etiquetadas</span>
      <span class="bt-m-f" aria-hidden="true"><Icono nombre="arrow-up-right" /></span>
    </a>

    <a class="bt-p bt-mini" href="/observaciones">
      <span class="bt-m-ic"><Icono nombre="chat-teardrop-text" /></span>
      <span class="bt-m-t">Deja una<br />observación</span>
      <span class="bt-m-f" aria-hidden="true"><Icono nombre="arrow-up-right" /></span>
    </a>

    <!-- ── pieza ancha: los ocho módulos ────────────────────────────── -->
    <section class="bt-p bt-mod" aria-label="Los ocho módulos">
      <p class="bt-et">El recorrido · {reglas.length} reglas en {MODULOS.length} módulos</p>
      <ol class="bt-l">
        {MODULOS.map((m) => (
          <li>
            <a href={`/${m.slug}`}>
              <span class="bt-ic"><Icono nombre={m.icono} /></span>
              <span class="bt-n num">{dos(m.n)}</span>
              <span class="bt-t">{m.corto}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Marco>

<style>
  /* Mosaico de cuatro columnas. Cada pieza dice cuanto ocupa; ninguna es del
     mismo tamano que su vecina, que es de lo que va este formato. */
  .bt {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--e-3);
  }

  .bt-p {
    position: relative;
    padding: var(--e-5);
    border-radius: var(--radio-4);
    border: 1px solid var(--vidrio-borde);
    background: var(--vidrio-fondo);
    background-image: var(--vidrio-brillo);
    box-shadow: var(--sombra-2);
  }

  /* ── titular ──────────────────────────────────────────────────────── */
  .bt-tit {
    grid-column: span 2; grid-row: span 2;
    display: flex; flex-direction: column; justify-content: center;
    padding: var(--e-7);
  }
  .bt-tit h1 {
    margin: 0 0 var(--e-4);
    font-size: clamp(var(--t-7), 2.7vw, var(--t-9));
    letter-spacing: -0.03em; line-height: 1.08;
  }
  .bt-nom { color: var(--acento); }
  .bt-tit p { margin: 0 0 var(--e-6); font-size: var(--t-4); color: var(--texto-2); }
  .bt-cta {
    align-self: flex-start;
    display: inline-flex; align-items: center; gap: var(--e-2);
    min-height: var(--alto-control);
    padding: var(--e-3) var(--e-5);
    border-radius: var(--radio-2);
    background: var(--acento); color: var(--sobre-acento);
    font-size: var(--t-3); font-weight: var(--peso-medio);
    box-shadow: var(--halo-boton);
    transition: background var(--normal), transform var(--normal);
  }
  .bt-cta:hover { background: var(--acento-vivo); color: var(--sobre-acento); transform: translateY(-1px); }
  .bt-cta:focus-visible { outline-color: var(--texto); }

  /* ── gráfico ──────────────────────────────────────────────────────── */
  .bt-gr {
    grid-column: span 2; grid-row: span 2;
    margin: 0; padding: var(--e-2);
    display: flex; flex-direction: column; gap: var(--e-2);
    box-shadow: var(--halo-azul), var(--sombra-2);
  }
  .bt-gr img {
    width: 100%; height: auto; display: block;
    border-radius: calc(var(--radio-4) - var(--e-2));
    flex: 1; object-fit: cover;
  }
  .bt-gr figcaption { padding: 0 var(--e-3) var(--e-2); font-size: var(--t-1); color: var(--texto-3); }

  /* ── piezas pequeñas ──────────────────────────────────────────────── */
  .bt-mini {
    grid-column: span 1;
    display: flex; flex-direction: column; justify-content: flex-end; gap: var(--e-2);
    min-height: 9rem;
    color: var(--texto);
    transition: background var(--normal), border-color var(--normal), transform var(--normal);
  }
  .bt-mini:hover {
    background: var(--vidrio-hover); border-color: color-mix(in srgb, var(--acento) 40%, transparent);
    color: var(--texto); transform: translateY(-2px);
  }
  .bt-m-n {
    font-size: var(--t-9); font-weight: var(--peso-max);
    line-height: 1; letter-spacing: var(--track-cifra); color: var(--acento);
  }
  .bt-m-ic {
    display: grid; place-items: center;
    width: 2.5rem; height: 2.5rem;
    border-radius: var(--radio-2);
    background: color-mix(in srgb, var(--info) 16%, transparent);
    color: var(--info);
    --i: 1.25rem;
  }
  .bt-m-t { font-size: var(--t-3); color: var(--texto-2); line-height: 1.35; }
  .bt-m-f {
    position: absolute; top: var(--e-4); right: var(--e-4);
    color: var(--texto-3); --i: 1rem;
    transition: color var(--normal), transform var(--normal);
  }
  .bt-mini:hover .bt-m-f { color: var(--acento); transform: translate(2px, -2px); }

  /* ── los ocho ─────────────────────────────────────────────────────── */
  .bt-mod { grid-column: span 2; }
  .bt-et {
    margin: 0 0 var(--e-3);
    font-size: var(--t-1); letter-spacing: var(--track-etiqueta);
    text-transform: uppercase; color: var(--texto-3);
  }
  .bt-l {
    list-style: none; margin: 0; padding: 0; max-width: none;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--e-2);
  }
  .bt-l li { margin: 0; }
  .bt-l a {
    display: grid; grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center; gap: var(--e-3);
    padding: var(--e-2) var(--e-3);
    border-radius: var(--radio-2);
    font-size: var(--t-3); color: var(--texto-2);
    transition: background var(--normal), color var(--normal);
  }
  .bt-l a:hover { background: var(--vidrio-hover); color: var(--texto); }
  .bt-ic { display: flex; color: var(--texto-3); --i: 1rem; }
  .bt-l a:hover .bt-ic { color: var(--acento); }
  .bt-n { font-size: var(--t-1); color: var(--texto-3); letter-spacing: var(--track-cifra); }
  .bt-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  @media (max-width: 1100px) {
    .bt { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bt-tit, .bt-gr, .bt-mod { grid-column: span 2; grid-row: auto; }
    .bt-tit { padding: var(--e-6); }
  }
  @media (max-width: 600px) {
    .bt { grid-template-columns: minmax(0, 1fr); }
    .bt-tit, .bt-gr, .bt-mod, .bt-mini { grid-column: span 1; }
    .bt-l { grid-template-columns: minmax(0, 1fr); }
  }
</style>
