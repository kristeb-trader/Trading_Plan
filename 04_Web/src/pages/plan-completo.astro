---
/**
 * El plan completo — la puerta de la capa 2.
 *
 * Aquí no se resume nada. Es el índice del detalle: las 38 reglas medibles,
 * los números, el vocabulario, el documento maestro y lo que sigue abierto.
 *
 * Existe para que el menú principal tenga tres entradas en vez de once. Quien
 * solo quiere entender la estrategia no baja aquí; quien quiere auditar, sí.
 */
import Marco from '../componentes/Marco.astro';
import Icono from '../componentes/Icono.astro';
import * as P from '../lib/parsers.mjs';

const reglas = P.reglas();
const cats = P.categorias();
const secciones = [
  {
    href: '/reglas', icono: 'list-checks', titulo: 'Las reglas',
    cuenta: reglas.length, unidad: 'reglas',
    texto: `Cada una con sus condiciones medibles y su acción, en ${cats.length} categorías. Es la base de la que saldrá el bot.`,
    principal: true,
  },
  {
    href: '/plan', icono: 'compass', titulo: 'El documento maestro',
    cuenta: P.subfasesDeclaradas().length, unidad: 'sub-fases',
    texto: 'El razonamiento completo detrás de cada decisión, en el orden en que se construyó.',
  },
  {
    href: '/parametros', icono: 'sliders-horizontal', titulo: 'Los números',
    cuenta: P.parametros().size, unidad: 'parámetros',
    texto: 'Todo lo que puede cambiar, en un solo sitio. Las reglas los citan por nombre.',
  },
  {
    href: '/glosario', icono: 'book-open', titulo: 'El vocabulario',
    cuenta: P.glosario().length, unidad: 'términos',
    texto: 'Cada término con una definición que se puede medir, no describir.',
  },
  {
    href: '/checklist', icono: 'check-square', titulo: 'La secuencia del día',
    cuenta: null, unidad: '4 bloques',
    texto: 'El proceso operativo en su orden real, en una vista imprimible.',
  },
  {
    href: '/pendientes', icono: 'warning-diamond', titulo: 'Lo que sigue abierto',
    cuenta: P.pendientesAbiertos().length, unidad: 'sin cerrar',
    texto: 'Las preguntas que el plan aún no responde, y las desviaciones conscientes.',
  },
  {
    href: '/contextualizacion', icono: 'chart-line', titulo: 'Lo que no es regla',
    cuenta: null, unidad: 'criterio',
    texto: 'Diez elementos que quedaron fuera del plan a propósito, porque no tienen número.',
  },
  {
    href: '/cierre', icono: 'seal-check', titulo: 'El acta de cierre',
    cuenta: null, unidad: 'qué está probado',
    texto: 'Qué quedó demostrado y qué no, escrito el día que se cerró la fase.',
  },
];
---

<Marco titulo="El plan completo">
  <header class="cab entra">
    <h1>El plan completo</h1>
    <p class="lead">
      Aquí está todo el detalle, sin resumir: las {reglas.length} reglas
      medibles, los números exactos y el razonamiento entero.
    </p>
    <p class="apunte">
      Si lo que buscas es entender la estrategia, empieza por{' '}
      <a href="/premercado">el recorrido de ocho módulos</a>. Esto de aquí es
      para comprobar y auditar.
    </p>
  </header>

  <div class="rejilla">
    {secciones.map((s, i) => (
      <a class:list={['sec', { principal: s.principal }, 'entra']} href={s.href}
         style={`--retraso:${Math.min(i, 6) * 40}ms`}>
        <span class="s-ic"><Icono nombre={s.icono} /></span>
        <span class="s-cab">
          <span class="s-t">{s.titulo}</span>
          <span class="s-c num">{s.cuenta ?? ''}<span class="s-u">{s.unidad}</span></span>
        </span>
        <span class="s-x">{s.texto}</span>
      </a>
    ))}
  </div>
</Marco>

<style>
  .cab { margin-bottom: var(--e-7); }
  .lead { font-size: var(--t-5); color: var(--texto-2); margin: var(--e-4) 0; }

  .rejilla { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--e-3); }
  .sec {
    grid-column: span 2;
    display: flex; flex-direction: column; gap: var(--e-3);
    padding: var(--e-5);
    border-radius: var(--radio-3);
    background: var(--vidrio-fondo);
    background-image: var(--vidrio-brillo);
    border: 1px solid var(--vidrio-borde);
    color: var(--texto-2);
    transition: transform var(--normal), box-shadow var(--normal);
  }
  .sec:hover { transform: translateY(-2px); box-shadow: var(--halo-azul); color: var(--texto-2); }
  .sec.principal { grid-column: span 4; }

  .s-ic { color: var(--texto-3); --i: 1.35rem; display: flex; }
  .sec:hover .s-ic { color: var(--acento); }
  .s-cab { display: flex; align-items: baseline; justify-content: space-between; gap: var(--e-4); }
  .s-t { font-size: var(--t-6); font-weight: var(--peso-fuerte); color: var(--texto); }
  .s-c {
    display: flex; align-items: baseline; gap: var(--e-2); flex: none;
    font-size: var(--t-7); font-weight: var(--peso-max); color: var(--texto);
    letter-spacing: var(--track-cifra);
  }
  .s-u {
    font-family: var(--fuente); font-size: var(--t-1); font-weight: var(--peso-medio);
    color: var(--texto-3); letter-spacing: var(--track-etiqueta); text-transform: uppercase;
  }
  .s-x { font-size: var(--t-3); }

  @media (max-width: 1000px) {
    .rejilla { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sec, .sec.principal { grid-column: span 2; }
  }
  @media (max-width: 700px) {
    .rejilla { grid-template-columns: 1fr; }
    .sec, .sec.principal { grid-column: span 1; }
  }
</style>
