---
/**
 * Portada.
 *
 * Ningun numero esta escrito a mano: todos se cuentan de 01_Plan/ en cada
 * compilacion. Y las cifras del backtesting no aparecen nunca sin sus cuatro
 * motivos en el mismo bloque.
 *
 * Lenguaje: rejilla suiza de 12 columnas, radio cero, sin sombras. Los datos
 * se presentan como en un terminal — filetes, monoespaciada y contraste
 * tipografico extremo — no como tarjetas.
 */
import Marco from '../componentes/Marco.astro';
import * as P from '../lib/parsers.mjs';

const v = P.version();
const reglas = P.reglas();
const cats = P.categorias();
const subfases = P.subfasesDeclaradas();
const glosario = P.glosario();
const galeria = P.galeria();
const abiertos = P.pendientesAbiertos();
const desviaciones = P.desviaciones();
const params = P.parametros();
const bt = P.backtesting();

const cifras = [
  { n: reglas.length, etiqueta: 'reglas', nota: `${cats.length} categorías` },
  { n: subfases.length, etiqueta: 'sub-fases', nota: 'plan completo' },
  { n: glosario.length, etiqueta: 'términos', nota: 'medibles' },
  { n: galeria.length, etiqueta: 'casos', nota: `${galeria.filter((c) => c.imagen).length} con gráfica` },
  { n: params.size, etiqueta: 'parámetros', nota: 'un solo sitio' },
  { n: abiertos.length, etiqueta: 'abiertos', nota: `${desviaciones.length} desviaciones` },
];

const MOTIVOS = [
  ['Muestra insuficiente', `${bt.operaciones} operaciones no dicen nada estadísticamente.`],
  ['Reglas en movimiento', 'Los primeros días se leyeron con reglas que después resultaron incorrectas.'],
  ['Sin filtro de noticias', 'Ninguna operación se descartó por noticia roja.'],
  ['Sin capa de contexto', 'Es la que quita varios de esos días, y todavía no existe.'],
];
---

<Marco titulo="Portada">
  <header class="portada entra">
    <p class="etiqueta pt-e">Metodología Alfredo Chaumer</p>
    <h1 class="pt-t">
      El plan está escrito.<br />
      <span class="pt-neg">No está probado.</span>
    </h1>
    <p class="pt-l">
      {reglas.length} reglas medibles, contrastadas contra 11 sesiones reales al
      tick. Esta página no añade metodología: renderiza los documentos del plan
      tal como están escritos.
    </p>
  </header>

  <!-- Tira de datos: filetes verticales, como un panel de cotizaciones. -->
  <section class="tira entra" aria-label="El plan en números">
    {cifras.map((c) => (
      <div class="dato">
        <span class="dato-n num" data-contar={c.n}>{c.n}</span>
        <span class="etiqueta dato-e">{c.etiqueta}</span>
        <span class="meta dato-x">{c.nota}</span>
      </div>
    ))}
  </section>

  <section class="seccion">
    <div class="corte entra">
      <span class="corte-n">01</span>
      <h2>Los cuatro huecos declarados</h2>
      <span class="meta">no es un olvido</span>
    </div>

    <ol class="huecos">
      {bt.huecos.map((h, i) => (
        <li class="hueco entra" style={`--retraso:${i * 60}ms`}>
          <span class="hueco-n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="hueco-t" set:html={P.tituloAHtml(P.sinNumeracion(h.titulo))} />
          <span class="hueco-e etiqueta">abierto</span>
        </li>
      ))}
    </ol>
    <p class="apunte huecos-p">
      La fase 1 se cerró <strong>sabiendo</strong> que estos cuatro puntos
      quedaban abiertos. El portal no puede presentarse como si no existieran.
    </p>
  </section>

  <section class="seccion">
    <div class="corte entra">
      <span class="corte-n">02</span>
      <h2>Lo que dio el backtesting</h2>
      <span class="meta">contrastado, no medido</span>
    </div>

    <div class="bt entra">
      <div class="bt-c">
        <span class="etiqueta">resultado acumulado</span>
        <span class="bt-n num">{bt.total}</span>
        <span class="meta bt-s">{bt.operaciones} operaciones · 11 sesiones al tick</span>
      </div>
      <div class="bt-m">
        <p class="bt-t">Esta cifra no mide la estrategia.</p>
        <dl class="motivos">
          {MOTIVOS.map(([t, d]) => (
            <div class="motivo">
              <dt class="motivo-t">{t}</dt>
              <dd class="motivo-d">{d}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <p class="meta cierre">
    v{v.version} · {v.fecha} · los contadores se leen de los archivos en cada compilación
  </p>
</Marco>

<style>
  /* ── portada ─────────────────────────────────────────────────────────── */
  .portada { margin-bottom: var(--e-8); }
  .pt-e { margin: 0 0 var(--e-5); color: var(--azul); }
  .pt-t {
    font-size: clamp(var(--t-7), 7vw, var(--t-9));
    letter-spacing: var(--track-cifra);
    margin: 0 0 var(--e-6);
    max-width: 16ch;
  }
  .pt-neg { color: var(--texto-3); }
  .pt-l { font-size: var(--t-5); color: var(--texto-2); max-width: 46ch; margin: 0; }

  /* ── tira de datos ───────────────────────────────────────────────────── */
  /* Filetes verticales entre celdas: panel de cotizaciones, no tarjetas. */
  .tira {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-top: 2px solid var(--filete-fuerte);
    border-bottom: 1px solid var(--filete);
    margin-bottom: var(--e-9);
  }
  .dato {
    display: flex; flex-direction: column;
    padding: var(--e-5) var(--e-4) var(--e-5) 0;
    border-right: 1px solid var(--filete-tenue);
  }
  .dato:last-child { border-right: 0; }
  .dato-n {
    font-size: var(--t-8); font-weight: var(--peso-max);
    line-height: 1; letter-spacing: var(--track-cifra);
    font-variant-numeric: tabular-nums;
  }
  .dato-e { margin-top: var(--e-3); color: var(--texto-2); }
  .dato-x { margin-top: var(--e-1); }

  /* ── secciones ───────────────────────────────────────────────────────── */
  .seccion { margin-bottom: var(--e-9); }

  /* ── huecos · lista con filete ───────────────────────────────────────── */
  .huecos { list-style: none; padding: 0; margin: 0; max-width: none; }
  .hueco {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 6rem;
    gap: var(--e-4);
    align-items: baseline;
    padding: var(--e-5) 0;
    margin: 0;
    border-bottom: 1px solid var(--filete-tenue);
    transition: background var(--transicion);
  }
  .hueco:hover { background: var(--sup-1); }
  .hueco-n {
    font-family: var(--fuente-mono); font-size: var(--t-2);
    color: var(--oro); letter-spacing: var(--track-etiqueta);
  }
  .hueco-t { margin: 0; font-size: var(--t-5); font-weight: var(--peso-medio); }
  .hueco-t :global(code) { color: var(--texto-3); font-size: var(--t-2); }
  .hueco-e { text-align: right; color: var(--oro); opacity: 0.75; }
  .huecos-p { margin-top: var(--e-5); }

  /* ── backtesting ─────────────────────────────────────────────────────── */
  .bt {
    display: grid;
    grid-template-columns: minmax(16rem, 24rem) minmax(0, 1fr);
    border-top: 2px solid var(--filete-fuerte);
  }
  .bt-c {
    display: flex; flex-direction: column;
    padding: var(--e-6) var(--e-6) var(--e-6) 0;
    border-right: 1px solid var(--filete);
  }
  .bt-n {
    font-size: clamp(var(--t-7), 4vw, var(--t-8)); font-weight: var(--peso-max);
    color: var(--rojo); line-height: 0.9;
    letter-spacing: var(--track-cifra);
    margin: var(--e-4) 0 var(--e-3);
    font-variant-numeric: tabular-nums;
  }
  .bt-m { padding: var(--e-6) 0 var(--e-6) var(--e-6); }
  .bt-t {
    margin: 0 0 var(--e-5); font-size: var(--t-5);
    font-weight: var(--peso-fuerte); color: var(--oro);
  }

  .motivos { margin: 0; display: grid; gap: 0; }
  .motivo {
    display: grid; grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--e-4);
    padding: var(--e-4) 0;
    border-top: 1px solid var(--filete-tenue);
  }
  .motivo-t {
    font-family: var(--fuente-mono); font-size: var(--t-1);
    letter-spacing: var(--track-etiqueta); text-transform: uppercase;
    color: var(--texto);
  }
  .motivo-d { margin: 0; font-size: var(--t-3); color: var(--texto-2); overflow-wrap: anywhere; }

  .cierre { margin-top: var(--e-8); }

  @media (max-width: 1100px) {
    .tira { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .dato { border-bottom: 1px solid var(--filete-tenue); }
    .dato:nth-child(3n) { border-right: 0; }
  }
  @media (max-width: 900px) {
    .hueco { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .hueco-e { display: none; }
    .bt { grid-template-columns: 1fr; }
    .bt-c { border-right: 0; border-bottom: 1px solid var(--filete); padding: var(--e-5) 0; }
    .bt-m { padding: var(--e-5) 0; }
    .motivo { grid-template-columns: 1fr; gap: var(--e-1); }
  }
  @media (max-width: 600px) {
    .tira { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dato:nth-child(3n) { border-right: 1px solid var(--filete-tenue); }
    .dato:nth-child(2n) { border-right: 0; }
  }
</style>
