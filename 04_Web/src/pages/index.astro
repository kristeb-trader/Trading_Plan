---
/**
 * Portada — la que abre Alfredo.
 *
 * Direccion «Terminal», elegida por el operador el 02/09/2026 entre tres
 * propuestas. Densa y de herramienta: franja de estado arriba en
 * monoespaciada, lista compacta de los ocho modulos a la izquierda y el
 * grafico en un panel a la derecha. Entra casi entera en una pantalla.
 *
 * Bordes visibles y radio corto en todo: es lo que da el aire de consola, y
 * es deliberado. Sale de ui-ux-pro-max (variance 8, density 9).
 *
 * Lo que NO va aqui (decidido el 02/09/2026):
 *   - «Trading Plan NQ» como titular: ya esta en el banner de la cabecera.
 *   - El aviso de «no probado» y los cuatro huecos declarados: viven en
 *     /tecnico, del lado del operador. Lo que no esta probado es la
 *     transcripcion del metodo, no el metodo de Alfredo.
 */
import Marco from '../componentes/Marco.astro';
import Icono from '../componentes/Icono.astro';
import * as P from '../lib/parsers.mjs';

const galeria = P.galeria();
const reglas = P.reglas();
const glosario = P.glosario();

const img = (id) => galeria.find((c) => c.id === id)?.imagen ?? null;
const heroe = img('G-16') ?? img('G-13') ?? galeria.find((c) => c.imagen)?.imagen;
const par = P.parametros();
const v = (n, alt) => par.get(n)?.valor ?? alt;

// La jornada en horas. Sustituye a la lista de los ocho modulos, que ya esta
// entera en el menu de la izquierda y salia dos veces (lo vio el operador).
//
// Las horas son las de PANTALLA en horario de verano de Nueva York, que es
// como las tiene el operador en su grafico. El ancla real es la apertura
// americana, no el numero del reloj: por eso la nota al pie. Nada de esto se
// inventa — sale de PARAMETROS.md y de los modulos de premercado y jornada.
const JORNADA = [
  {
    h: '19:00',
    t: 'Premercado',
    d: 'Empiezan a marcarse zonas por volumen, desde la apertura de Tokio.',
  },
  {
    h: '08:30',
    t: 'Abre el mercado americano',
    d: 'Arranca la única ventana del día en la que se coloca una orden.',
  },
  {
    h: '08:31',
    t: 'La primera vela',
    d: 'Declara la dirección con su propio cuerpo, y es el origen del primer tramo.',
  },
  {
    h: '10:29',
    t: 'Última orden',
    d: 'Pasado ese minuto ya no se coloca nada, por buena que sea la figura.',
    hito: true,
  },
  {
    h: '10:30',
    t: 'Cierra la ventana',
    d: 'Prohíbe abrir, no obliga a cerrar: una operación viva sigue viva.',
  },
];

// Los tres primeros salen del plan; los tres ultimos se cuentan del archivo.
const ESTADO = [
  { k: 'Instrumento', v: 'NQ · MNQ' },
  { k: 'Marco', v: '1 min' },
  { k: 'Ventana', v: '08:30 – 10:30' },
  { k: 'Reglas', v: String(reglas.length) },
  { k: 'Casos', v: String(galeria.length) },
  { k: 'Términos', v: String(glosario.length) },
];
---

<Marco titulo="Inicio">
  <!-- ── franja de estado ───────────────────────────────────────────── -->
  <dl class="tm-estado" aria-label="Parámetros del método">
    {ESTADO.map((e) => (
      <div class="tm-e">
        <dt>{e.k}</dt>
        <dd class="num">{e.v}</dd>
      </div>
    ))}
  </dl>

  <div class="tm-rej">
    <!-- ── columna izquierda: titular y los ocho ────────────────────── -->
    <div class="tm-izq">
      <header class="tm-cab">
        <h1>
          Plan de trading enfocado en la metodología de{' '}
          <span class="tm-nom tm-ac">Alfredo Chaumer</span>.
        </h1>
        <p>
          Un método de trading para NQ y MNQ, traducido a reglas que se pueden
          medir, seguir y operar.
        </p>
      </header>

      <!-- El texto va envuelto en un span: la rejilla reparte UN hijo por
           celda, y sin el envoltorio el <strong> se iba a su propia celda y
           partia la frase. -->
      <p class="tm-nota">
        <Icono nombre="info" />
        <span>
          Al llenarse la orden <strong>el día se acabó</strong>:
          {' '}{v('OPS_POR_SESION', '1 llenada')} por sesión, y tampoco se
          sigue analizando.
        </span>
      </p>
    </div>

    <!-- ── columna derecha: el panel del gráfico ────────────────────── -->
    <figure class="tm-panel">
      <!-- El recorte esconde la banda de titulares que el grafico trae
           impresa: la fecha, el recuento de zonas y la linea verde de la
           operacion. NO se toca el archivo — la galeria lo sigue mostrando
           entero, con esa informacion, que alli si hace falta.
           2000x1060 originales, menos 215px de banda = 2000x845. -->
      <div class="tm-corte">
        <img src={heroe} width="2000" height="1060" decoding="async" loading="eager"
             alt="Una sesión real con las zonas marcadas y la operación" />
      </div>
      <figcaption class="tm-p-pie">
        <a class="tm-b1" href="/premercado">Empezar por el principio <Icono nombre="arrow-right" /></a>
        <a class="tm-b2" href="/galeria">{galeria.length} casos reales</a>
      </figcaption>
    </figure>
  </div>

  <!-- ── la jornada, en horas ───────────────────────────────────────── -->
  <!-- Va debajo y a todo el ancho, alineada con el eje de horas del grafico
       de arriba. Sustituye a la lista de los ocho modulos, que ya esta entera
       en el menu de la izquierda y salia dos veces. -->
  <section class="tm-jor" aria-label="La jornada en horas">
    <p class="tm-et">La jornada en horas</p>
    <ol class="tm-j">
      {JORNADA.map((x) => (
        <li class:list={{ hito: x.hito }}>
          <span class="tm-h num">{x.h}</span>
          <span class="tm-jt">{x.t}</span>
          <span class="tm-jd">{x.d}</span>
        </li>
      ))}
    </ol>
    <p class="tm-pie-h">
      Horas de pantalla en <strong>verano de Nueva York</strong>. El ancla es la
      apertura del mercado americano, no el número del reloj: en invierno la
      misma ventana cae una hora más tarde.
    </p>
  </section>
</Marco>

<style>
  /* ── franja de estado ─────────────────────────────────────────────── */
  /* Un pixel de separacion sobre el color del borde: las celdas quedan
     pegadas y con filete, como una tabla de plataforma. */
  .tm-estado {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1px;
    margin: 0 0 var(--e-5);
    background: var(--borde);
    border: 1px solid var(--borde);
    border-radius: var(--radio-1);
    overflow: hidden;
  }
  .tm-e { padding: var(--e-3) var(--e-4); background: var(--superficie); }
  .tm-e dt {
    font-size: var(--t-1); letter-spacing: var(--track-etiqueta);
    text-transform: uppercase; color: var(--texto-3);
  }
  .tm-e dd {
    margin: 2px 0 0;
    font-size: var(--t-4); font-weight: var(--peso-medio); color: var(--texto);
    letter-spacing: var(--track-cifra);
  }

  /* ── reparto ──────────────────────────────────────────────────────── */
  /* Las dos columnas se estiran igual (align-items por defecto), asi que el
     panel y la columna del texto acaban al MISMO nivel. Lo intente con
     align-items:start y quedaban desalineados 261px.
     La columna del texto es estrecha a proposito: cada rem que suelta se lo
     lleva el grafico, que es lo que se quiere ver grande. */
  .tm-rej {
    display: grid; grid-template-columns: minmax(0, 21rem) minmax(0, 1fr);
    gap: var(--e-5); align-items: stretch;
  }
  .tm-izq { min-width: 0; }

  .tm-cab { margin-bottom: var(--e-6); }
  .tm-cab h1 {
    margin: 0 0 var(--e-4);
    font-size: clamp(var(--t-7), 2.4vw, var(--t-8));
    letter-spacing: -0.03em; line-height: 1.12;
  }
  /* Su nombre no se parte entre dos lineas. */
  .tm-nom { white-space: nowrap; }
  .tm-ac { color: var(--acento); }
  .tm-cab p { margin: 0; font-size: var(--t-4); color: var(--texto-2); }

  .tm-et {
    margin: 0 0 var(--e-2);
    font-size: var(--t-1); letter-spacing: var(--track-etiqueta);
    text-transform: uppercase; color: var(--texto-3);
  }

  /* ── la jornada, en horas ─────────────────────────────────────────── */
  /* Banda horizontal: las paradas corren de izquierda a derecha como el eje
     de horas del grafico de arriba. No lleva enlaces — no compite con el
     menu, informa. */
  .tm-jor {
    margin-top: var(--e-6);
    padding: var(--e-5);
    border: 1px solid var(--borde);
    border-radius: var(--radio-1);
    background: var(--superficie);
  }
  .tm-j {
    list-style: none; margin: 0; padding: 0; max-width: none;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }
  .tm-j li {
    position: relative;
    margin: 0;
    padding: var(--e-5) var(--e-5) 0 0;
    /* El filete superior de cada parada, todos seguidos, forman el rail. */
    border-top: 1px solid var(--borde);
  }
  /* El punto de cada parada, montado sobre el rail. */
  .tm-j li::before {
    content: '';
    position: absolute; left: 0; top: -4px;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--n-500);
  }
  .tm-j li.hito { border-top-color: color-mix(in srgb, var(--acento) 55%, transparent); }
  .tm-j li.hito::before { background: var(--acento); }

  .tm-h {
    display: block;
    font-size: var(--t-3); color: var(--texto-2);
    letter-spacing: var(--track-cifra);
  }
  .tm-j li.hito .tm-h { color: var(--acento); }
  .tm-jt {
    display: block; margin-top: var(--e-1);
    font-size: var(--t-3); font-weight: var(--peso-medio); color: var(--texto);
    line-height: 1.3;
  }
  .tm-jd {
    display: block; margin-top: var(--e-2);
    font-size: var(--t-2); color: var(--texto-3); line-height: 1.45;
  }

  .tm-pie-h {
    margin: var(--e-5) 0 0;
    padding-top: var(--e-3);
    border-top: 1px solid var(--borde-sutil);
    font-size: var(--t-1); color: var(--texto-3); max-width: none;
  }
  .tm-pie-h strong { color: var(--texto-2); }

  /* La salvedad del titular, en la columna del texto. */
  .tm-nota {
    display: grid; grid-template-columns: auto minmax(0, 1fr);
    gap: var(--e-2);
    margin: var(--e-5) 0 0;
    font-size: var(--t-2); color: var(--texto-3); line-height: 1.5;
  }
  .tm-nota :global(.icono) { margin-top: 2px; color: var(--texto-3); --i: 0.875rem; }
  .tm-nota strong { color: var(--texto-2); }

  /* ── panel del gráfico ────────────────────────────────────────────── */
  /* Columna flexible: el grafico arriba y el pie empujado al fondo, para que
     el panel llene su altura sin estirar la imagen. */
  .tm-panel {
    margin: 0; min-width: 0;
    display: flex; flex-direction: column;
    border: 1px solid var(--borde);
    border-radius: var(--radio-1);
    background: var(--superficie);
    overflow: hidden;
  }
  /* Recorte por proporcion: la caja es mas baja que la imagen, y `cover`
     anclado abajo deja fuera la banda de arriba. Asi no hay que recortar el
     archivo ni recalcular nada si cambia el ancho. */
  .tm-corte { aspect-ratio: 2000 / 845; overflow: hidden; }
  .tm-corte img {
    width: 100%; height: 100%; display: block;
    object-fit: cover; object-position: 50% 100%;
  }
  .tm-p-pie {
    display: flex; align-items: center; justify-content: center;
    gap: var(--e-3); flex-wrap: wrap;
    margin-top: auto;
    padding: var(--e-4);
    border-top: 1px solid var(--borde);
  }
  .tm-b1 {
    display: inline-flex; align-items: center; gap: var(--e-2);
    min-height: var(--alto-control);
    padding: var(--e-2) var(--e-5);
    border-radius: var(--radio-1);
    background: var(--acento); color: var(--sobre-acento);
    font-size: var(--t-3); font-weight: var(--peso-medio);
    transition: background var(--normal);
  }
  .tm-b1:hover { background: var(--acento-vivo); color: var(--sobre-acento); }
  /* El anillo de foco global es del color del acento y sobre este relleno no
     se veria. Aqui se pinta en claro. */
  .tm-b1:focus-visible { outline-color: var(--texto); }
  .tm-b2 {
    display: inline-flex; align-items: center;
    min-height: var(--alto-control);
    padding: var(--e-2) var(--e-5);
    border-radius: var(--radio-1);
    border: 1px solid var(--borde);
    color: var(--texto-2); font-size: var(--t-3);
    transition: border-color var(--normal), color var(--normal);
  }
  .tm-b2:hover { border-color: var(--n-600); color: var(--texto); }

  /* Por debajo de este ancho la columna del texto se queda sin sitio para el
     titular, y las dos columnas se apilan. */
  @media (max-width: 1100px) {
    .tm-rej { grid-template-columns: 1fr; }
  }
</style>
