---
// PROVISIONAL — fase 1/2. Solo demuestra que el circuito completo funciona:
// 01_Plan -> sync -> src/lib -> pagina. El diseno entra en la fase 3.
//
// Ni un solo numero de esta pagina esta escrito a mano: todos se cuentan.
import * as P from '../lib/parsers.mjs';

const v = P.version();
const reglas = P.reglas();
const cats = P.categorias();
const subfases = P.subfasesDeclaradas();
const glosario = P.glosario();
const galeria = P.galeria();
const abiertos = P.pendientesAbiertos();
const ctx = P.contextualizacion();
const params = P.parametros();
const bt = P.backtesting();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Plan Chaumer · v{v.version}</title>
    <style>
      :root { color-scheme: dark; }
      body {
        background: #0B0E14; color: #FFFFFF; margin: 0; padding: 2rem 1.25rem;
        font: 16px/1.6 ui-sans-serif, system-ui, sans-serif;
      }
      main { max-width: 46rem; margin: 0 auto; }
      h1 { font-size: 1.5rem; margin: 0 0 .25rem; }
      .banda {
        border: 1px solid #FF5C5C; color: #FF5C5C; padding: .6rem .8rem;
        margin: 1.5rem 0; font-size: .9rem;
      }
      dl { display: grid; grid-template-columns: auto 1fr; gap: .35rem 1rem; margin: 0; }
      dt { color: #8B93A7; } dd { margin: 0; font-variant-numeric: tabular-nums; }
      .apunte { color: #8B93A7; font-size: .85rem; }
    </style>
  </head>
  <body>
    <main>
      <h1>Plan de trading Chaumer</h1>
      <p class="apunte">versión {v.version} · {v.fecha}</p>

      <div class="banda">
        <strong>El plan está escrito y contrastado, pero NO probado.</strong>
        Se cerró con {bt.huecos.length} huecos declarados. El backtesting dio
        {bt.total} en {bt.operaciones} operaciones, y esa cifra no mide la
        estrategia.
      </div>

      <dl>
        <dt>reglas</dt><dd>{reglas.length} en {cats.length} categorías</dd>
        <dt>sub-fases</dt><dd>{subfases.length}</dd>
        <dt>términos</dt><dd>{glosario.length}</dd>
        <dt>casos</dt><dd>{galeria.length}</dd>
        <dt>parámetros</dt><dd>{params.size}</dd>
        <dt>pendientes abiertos</dt><dd>{abiertos.length}</dd>
        <dt>elementos de contexto</dt>
        <dd>{ctx.items.length} encabezados · {new Set(ctx.items.map((i) => i.id)).size} identificadores</dd>
      </dl>

      <p class="apunte">
        Esqueleto provisional. Ningún número de esta página está escrito en el
        código: todos se cuentan de <code>01_Plan/</code> en cada compilación.
      </p>
    </main>
  </body>
</html>
