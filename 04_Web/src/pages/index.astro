---
/**
 * Portada de bienvenida — la que abre Alfredo.
 *
 * Presenta el metodo en pocas lineas y deja elegir camino: recorrerlo, o ver
 * como se aplica. No explica el metodo aqui: para eso estan los ocho modulos.
 *
 * Lo que NO va en esta pagina (decidido por el operador el 02/09/2026):
 * el aviso de «no probado», los cuatro huecos declarados y los contadores del
 * plan. Todo eso vive en /tecnico, del lado del operador. Lo que no esta
 * probado es la transcripcion del metodo, no el metodo de Alfredo.
 *
 * El material visual son los graficos reales del operador, presentados de
 * frente. Nada de cajas inventadas simulando una pantalla.
 */
import Marco from '../componentes/Marco.astro';
import Icono from '../componentes/Icono.astro';
import * as P from '../lib/parsers.mjs';

const galeria = P.galeria();

const img = (id) => galeria.find((c) => c.id === id)?.imagen ?? null;
const heroe = img('G-16') ?? img('G-13') ?? galeria.find((c) => c.imagen)?.imagen;

// Dos bloques en zigzag, no tres tarjetas iguales.
const CAMINOS = [
  {
    href: '/premercado',
    titulo: 'Recorrer el método',
    texto: 'Ocho módulos, en el orden real de la jornada: qué se prepara antes, qué se busca en el gráfico, cómo se entra y cuándo no se entra.',
    imagen: '/conceptos/02-corrida-retroceso.png',
    cta: 'Empezar por aquí',
    principal: true,
  },
  {
    href: '/galeria',
    titulo: 'Ver cómo se aplica',
    texto: `${galeria.length} sesiones reales del gráfico del operador, cada una etiquetada con lo que la explica. Es el material con el que se entrena el ojo.`,
    imagen: img('G-19') ?? img('G-17'),
    cta: 'Ver los casos',
  },
];
---

<Marco titulo="Inicio">
  <!-- ── bienvenida ────────────────────────────────────────────────────── -->
  <section class="hero" aria-label="Bienvenida">
    <div class="hero-txt entra">
      <h1>
        La metodología de <span class="h1-nom">Alfredo Chaumer,</span>{' '}
        <span class="h1-ac">explicada.</span>
      </h1>
      <p class="lead">
        Un método de trading para NQ y MNQ, traducido a reglas que se pueden
        medir, seguir y operar.
      </p>
      <!-- Sin botones aquí, por decisión del operador (02/09/2026): los dos
           que había repetían los de las secciones de abajo, que además
           explican a dónde llevan. El titular no necesita competencia. -->
    </div>

    {heroe && (
      <figure class="hero-gr entra" style="--retraso:120ms">
        <div class="hero-gr-in vidrio borde-vivo">
          <img src={heroe} width="2000" height="1060" decoding="async"
               alt="Una sesión real con las zonas marcadas y la operación" loading="eager" />
        </div>
      </figure>
    )}
  </section>

  <!-- ── los dos caminos, en zigzag ────────────────────────────────────── -->
  {CAMINOS.map((c, i) => (
    <section class:list={['camino', { invertido: i % 2 === 1 }, 'entra']} aria-label={c.titulo}>
      <div class="cm-txt">
        <h2>{c.titulo}</h2>
        <p>{c.texto}</p>
        <a class:list={[c.principal ? 'btn-1' : 'btn-2']} href={c.href}>
          {c.cta} <Icono nombre="arrow-right" />
        </a>
      </div>
      {c.imagen && (
        <a class="cm-fig" href={c.href} aria-hidden="true" tabindex="-1">
          <img src={c.imagen} width="1760" height="880" decoding="async" alt="" loading="lazy" />
        </a>
      )}
    </section>
  ))}
</Marco>

<style>
  /* ── bienvenida ──────────────────────────────────────────────────────── */
  .hero {
    display: grid; gap: var(--e-7);
    margin-bottom: var(--e-9);
  }
  .hero-txt h1 {
    margin: 0 0 var(--e-5);
    font-size: clamp(var(--t-9), 4vw, var(--t-10));
  }
  /* Enfasis por color, no por degradado: el degradado partia la palabra en
     «ex» blanco y «plicada.» azul. */
  .h1-ac { color: var(--acento); }
  /* Su nombre no se parte entre dos lineas. */
  .h1-nom { white-space: nowrap; }
  .lead { font-size: var(--t-5); color: var(--texto-2); max-width: 42ch; }

  .btn-1, .btn-2 {
    display: inline-flex; align-items: center; gap: var(--e-2);
    min-height: var(--alto-control);
    padding: var(--e-3) var(--e-5);
    border-radius: var(--radio-2);
    font-size: var(--t-3); font-weight: var(--peso-medio);
    transition: background var(--normal), box-shadow var(--normal), transform var(--normal);
  }
  .btn-1 {
    background: var(--acento); color: var(--sobre-acento);
    box-shadow: var(--halo-boton);
  }
  .btn-1:hover { background: var(--acento-vivo); color: var(--sobre-acento); transform: translateY(-1px); }
  /* El anillo de foco global es del color del acento, y sobre un boton de
     acento no se ve. Aqui se pinta en claro. */
  .btn-1:focus-visible { outline-color: var(--texto); }
  .btn-2 {
    background: var(--vidrio-fondo); color: var(--texto);
    border: 1px solid var(--vidrio-borde);
    backdrop-filter: var(--desenfoque);
  }
  .btn-2:hover { background: var(--vidrio-hover); color: var(--texto); }

  /* El grafico va de frente. Es una grafica real del operador y el estandar
     que el valido dice «cuanto mas limpio, mejor»: inclinarla en 3D la dejaba
     ilegible y contradecia su propia norma. El volumen lo da el cristal. */
  .hero-gr { margin: 0; }
  .hero-gr-in {
    padding: var(--e-2);
    box-shadow: var(--halo-azul), var(--sombra-3);
  }
  .hero-gr-in img { width: 100%; height: auto; display: block; border-radius: calc(var(--radio-4) - var(--e-2)); }

  /* ── caminos ─────────────────────────────────────────────────────────── */
  .camino {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: var(--e-8); align-items: center;
    margin-bottom: var(--e-9);
  }
  .camino:last-of-type { margin-bottom: var(--e-6); }
  .camino.invertido .cm-txt { order: 2; }
  .cm-txt h2 { margin: 0 0 var(--e-4); font-size: var(--t-7); }
  .cm-txt p { font-size: var(--t-4); color: var(--texto-2); max-width: 44ch; }
  .cm-txt .btn-1, .cm-txt .btn-2 { margin-top: var(--e-4); }

  .cm-fig {
    display: block; overflow: hidden;
    border-radius: var(--radio-3);
    border: 1px solid var(--vidrio-borde);
    background: var(--fondo);
  }
  .cm-fig img { width: 100%; height: auto; display: block; transition: transform var(--entrada); }
  .cm-fig:hover img { transform: scale(1.02); }

  /* Dos anchos, y cada uno con su motivo:

     1200 — con el rail lateral puesto, dos columnas dejan al titular unos
     300px y se parte en cinco lineas. El hero y los caminos se apilan antes
     de que eso pase. Es una decision de contenido.

     900 — el marco: aqui el rail pasa a barra superior. Lo fija Marco.astro
     y esta pagina no lo toca. (El fallo viejo era tener 1000 aqui y 900 alli:
     una franja con rail lateral y hero ya apilado.) */
  /* En pantalla estrecha el titular baja de escalon: a 60px se parte en
     «La metodologia / de / Alfredo Chaumer,» y deja un «de» solo. */
  @media (max-width: 600px) {
    .hero-txt h1 { font-size: var(--t-8); }
  }

  @media (max-width: 1200px) {
    .camino { grid-template-columns: 1fr; gap: var(--e-6); }
    .camino.invertido .cm-txt { order: 0; }
    .cm-fig { max-width: 46rem; }
  }
</style>
