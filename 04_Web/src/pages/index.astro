---
/**
 * Inicio.
 *
 * El material visual de este proyecto son los graficos del operador, y hasta
 * ahora no aparecia ninguno. Aqui la sesion real es la protagonista: fondo
 * con aurora, piezas de cristal y una rejilla bento donde las imagenes pesan
 * tanto como el texto.
 *
 * Ningun numero esta escrito a mano: todos se cuentan de 01_Plan/. Y la cifra
 * del backtesting nunca aparece sin sus cuatro motivos al lado.
 */
import Marco from '../componentes/Marco.astro';
import * as P from '../lib/parsers.mjs';

const reglas = P.reglas();
const cats = P.categorias();
const subfases = P.subfasesDeclaradas();
const glosario = P.glosario();
const galeria = P.galeria();
const abiertos = P.pendientesAbiertos();
const desviaciones = P.desviaciones();
const params = P.parametros();
const bt = P.backtesting();

// Graficas reales del operador, resueltas por el manifiesto de la galeria.
const porId = new Map(galeria.map((c) => [c.id, c]));
const gr = (id) => porId.get(id)?.imagen ?? null;
const heroe = gr('G-16') ?? gr('G-13') ?? galeria.find((c) => c.imagen)?.imagen;
const tile1 = gr('G-19') ?? gr('G-17');
const tile2 = gr('G-21') ?? gr('G-20');

const MOTIVOS = [
  ['Muestra insuficiente', `${bt.operaciones} operaciones no dicen nada estadísticamente.`],
  ['Las reglas se movían', 'Los primeros días se leyeron con reglas que después resultaron ser incorrectas.'],
  ['Sin filtro de noticias', 'Ninguna operación se descartó por noticia roja.'],
  ['Falta la capa de contexto', 'Es la que quita varios de esos días, y todavía no existe.'],
];
---

<Marco titulo="Inicio">
  <!-- ── portada ─────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-txt entra">
      <span class="marca-estado aviso frase">Escrito y contrastado. No probado.</span>
      <h1>
        La metodología de Alfredo Chaumer,{' '}
        <span class="degradado">traducida a {reglas.length} reglas medibles.</span>
      </h1>
      <p class="lead">
        Sin adjetivos. Solo ticks, puntos, número de velas y horas exactas.
        Contrastadas contra 11 sesiones reales reconstruidas al tick.
      </p>
      <div class="hero-cta">
        <button class="btn btn-1" type="button" data-abrir-buscador>
          Buscar en el plan
          <kbd class="tecla">Ctrl K</kbd>
        </button>
        <a class="btn btn-2" href="/reglas">Ver las {reglas.length} reglas</a>
      </div>
    </div>

    {heroe && (
      <figure class="hero-gr entra" style="--retraso:120ms">
        <div class="hero-gr-in vidrio borde-vivo">
          <img src={heroe} alt="Sesión real del 13 de julio de 2026 con las zonas marcadas y la operación" loading="eager" />
        </div>
        <figcaption class="meta">Una de las 11 sesiones reconstruidas al tick</figcaption>
      </figure>
    )}
  </section>

  <!-- ── rejilla bento ───────────────────────────────────────────────── -->
  <section class="bento">
    <a class="tile tile-reglas vidrio entra" href="/reglas">
      <span class="tile-n num">{reglas.length}</span>
      <span class="tile-t">Reglas medibles</span>
      <span class="tile-x">Con sus condiciones, su acción y el caso real que la fijó. En {cats.length} categorías.</span>
    </a>

    <a class="tile tile-galeria entra" href="/galeria" style="--retraso:60ms">
      {tile1 && <img class="tile-img" src={tile1} alt="" loading="lazy" />}
      <span class="tile-cap">
        <span class="tile-t">{galeria.length} casos reales</span>
        <span class="tile-x">Capturas del gráfico, etiquetadas con las reglas que las explican.</span>
      </span>
    </a>

    <a class="tile vidrio entra" href="/glosario" style="--retraso:110ms">
      <span class="tile-n num">{glosario.length}</span>
      <span class="tile-t">Términos</span>
      <span class="tile-x">Cada uno con una definición que se puede medir.</span>
    </a>

    <a class="tile vidrio entra" href="/parametros" style="--retraso:150ms">
      <span class="tile-n num">{params.size}</span>
      <span class="tile-t">Parámetros</span>
      <span class="tile-x">Los números que pueden cambiar, en un solo sitio.</span>
    </a>

    <a class="tile tile-plan vidrio entra" href="/plan" style="--retraso:190ms">
      <span class="tile-n num">{subfases.length}</span>
      <span class="tile-t">Sub-fases del plan</span>
      <span class="tile-x">El documento maestro entero, con el razonamiento detrás de cada decisión.</span>
    </a>

    <a class="tile tile-sesion entra" href="/checklist" style="--retraso:230ms">
      {tile2 && <img class="tile-img" src={tile2} alt="" loading="lazy" />}
      <span class="tile-cap">
        <span class="tile-t">La secuencia del día</span>
        <span class="tile-x">Cuatro bloques, en su orden real.</span>
      </span>
    </a>
  </section>

  <!-- ── estado del plan ─────────────────────────────────────────────── -->
  <section class="estado vidrio entra">
    <div class="es-cab">
      <h2>El plan no está probado, y el portal no lo esconde</h2>
      <p class="apunte">
        La fase 1 se cerró sabiendo que estos cuatro puntos quedaban abiertos.
        Ninguno es un olvido.
      </p>
      <a class="btn btn-2 es-btn" href="/cierre">Leer el acta de cierre</a>
    </div>
    <ul class="huecos">
      {bt.huecos.map((h, i) => (
        <li class="hueco" style={`--retraso:${i * 50}ms`}>
          <span class="hueco-t" set:html={P.tituloAHtml(P.sinNumeracion(h.titulo))} />
        </li>
      ))}
    </ul>
  </section>

  <!-- ── backtesting ─────────────────────────────────────────────────── -->
  <section class="bt vidrio entra">
    <div class="bt-c">
      <span class="etiqueta">Resultado acumulado</span>
      <span class="bt-n num">{bt.total}</span>
      <span class="meta">{bt.operaciones} operaciones en 11 sesiones</span>
      <p class="bt-t">Esta cifra no mide la estrategia.</p>
    </div>
    <dl class="motivos">
      {MOTIVOS.map(([t, d]) => (
        <div class="motivo">
          <dt>{t}</dt>
          <dd>{d}</dd>
        </div>
      ))}
    </dl>
  </section>

  <p class="pendientes-nota meta">
    Quedan {abiertos.length} puntos sin cerrar y {desviaciones.length} desviaciones
    conscientes respecto al material del curso. <a href="/pendientes">Verlos todos</a>
  </p>
</Marco>

<style>
  /* Frase completa: sin versalitas, que a 34 caracteres cuesta leerlas. */
  .marca-estado.frase { text-transform: none; letter-spacing: 0; font-size: var(--t-2); }

  /* ── portada ─────────────────────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--e-8);
    align-items: center;
    margin-bottom: var(--e-9);
  }
  .hero-txt h1 { margin: var(--e-5) 0; font-size: clamp(var(--t-7), 3.6vw, 3rem); }
  .lead { font-size: var(--t-5); color: var(--texto-2); max-width: 40ch; }

  .hero-cta { display: flex; gap: var(--e-3); flex-wrap: wrap; margin-top: var(--e-6); }
  .btn {
    display: inline-flex; align-items: center; gap: var(--e-3);
    padding: var(--e-3) var(--e-5);
    border-radius: var(--radio-2);
    font: inherit; font-size: var(--t-3); font-weight: var(--peso-medio);
    cursor: pointer;
    transition: transform var(--normal), box-shadow var(--normal), background var(--normal);
  }
  .btn:active { transform: translateY(1px); }
  .btn-1 {
    background: var(--acento); color: #06121F; border: 0;
    box-shadow: 0 8px 24px -8px rgba(76, 141, 255, 0.7);
  }
  .btn-1:hover { background: #6AA0FF; box-shadow: 0 12px 30px -8px rgba(76, 141, 255, 0.85); color: #06121F; }
  .btn-1 .tecla { background: rgba(255,255,255,0.92); border-color: rgba(255,255,255,0.6); color: #0A2550; }
  .btn-2 {
    background: var(--vidrio-fondo); color: var(--texto);
    border: 1px solid var(--vidrio-borde);
    backdrop-filter: var(--desenfoque);
  }
  .btn-2:hover { background: rgba(255,255,255,0.08); color: var(--texto); }

  /* La grafica, ligeramente girada y elevada: deja de ser una captura pegada
     y pasa a ser una pieza dentro de la pagina. */
  .hero-gr { margin: 0; }
  .hero-gr-in {
    padding: var(--e-2);
    transform: perspective(1400px) rotateY(-7deg) rotateX(2.5deg);
    transition: transform var(--entrada);
    box-shadow: var(--halo-azul), var(--sombra-3);
  }
  .hero-gr-in:hover { transform: perspective(1400px) rotateY(-3deg) rotateX(1deg); }
  .hero-gr-in img { border-radius: calc(var(--radio-4) - var(--e-2)); display: block; width: 100%; }
  .hero-gr figcaption { margin-top: var(--e-4); text-align: right; }

  /* ── bento ───────────────────────────────────────────────────────────── */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(9.5rem, auto);
    gap: var(--e-3);
    margin-bottom: var(--e-9);
  }
  .tile {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; gap: var(--e-2);
    padding: var(--e-5);
    border-radius: var(--radio-4);
    color: var(--texto-2);
    grid-column: span 2;
    transition: transform var(--normal), box-shadow var(--normal), border-color var(--normal);
  }
  .tile:hover { transform: translateY(-3px); color: var(--texto-2); box-shadow: var(--halo-azul); }
  .tile-n {
    font-size: var(--t-9); font-weight: var(--peso-max);
    line-height: 1; letter-spacing: var(--track-cifra); color: var(--texto);
  }
  .tile-t { font-size: var(--t-4); font-weight: var(--peso-fuerte); color: var(--texto); }
  .tile-x { font-size: var(--t-3); }

  .tile-reglas { grid-column: span 2; grid-row: span 2; justify-content: center; }
  .tile-reglas .tile-n { font-size: 5rem; }
  .tile-plan { grid-column: span 2; }

  /* Tiles con grafica: la imagen ocupa el fondo y el texto va encima con
     un velo que garantiza el contraste. */
  .tile-galeria { grid-column: span 4; grid-row: span 2; padding: 0; justify-content: flex-end; border: 1px solid var(--vidrio-borde); background: var(--n-950); }
  .tile-sesion  { grid-column: span 4; padding: 0; justify-content: flex-end; border: 1px solid var(--vidrio-borde); background: var(--n-950); }
  .tile-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; object-position: center top;
    opacity: 0.62;
    transition: transform var(--entrada), opacity var(--normal);
  }
  .tile-galeria:hover .tile-img,
  .tile-sesion:hover .tile-img { transform: scale(1.03); opacity: 0.78; }
  .tile-cap {
    position: relative;
    display: flex; flex-direction: column; gap: var(--e-2);
    padding: var(--e-6) var(--e-5) var(--e-5);
    background: linear-gradient(0deg, rgba(10,12,17,0.96) 32%, rgba(10,12,17,0) 100%);
  }

  /* ── estado ──────────────────────────────────────────────────────────── */
  .estado {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: var(--e-7);
    padding: var(--e-7);
    margin-bottom: var(--e-8);
    box-shadow: var(--halo-oro), var(--sombra-2);
  }
  .es-cab h2 { margin: 0 0 var(--e-3); font-size: var(--t-7); color: var(--aviso); }
  .es-cab p { margin: 0 0 var(--e-5); }
  .es-btn { display: inline-flex; }

  .huecos { list-style: none; padding: 0; margin: 0; max-width: none; display: grid; gap: var(--e-2); }
  .hueco {
    margin: 0; padding: var(--e-4);
    background: rgba(255, 255, 255, 0.035);
    border-radius: var(--radio-2);
    font-size: var(--t-3); color: var(--texto-2);
  }
  .hueco :global(code) { color: var(--texto-3); font-size: var(--t-1); }

  /* ── backtesting ─────────────────────────────────────────────────────── */
  .bt {
    display: grid; grid-template-columns: minmax(13rem, 17rem) minmax(0, 1fr);
    gap: var(--e-7);
    padding: var(--e-7);
    margin-bottom: var(--e-5);
  }
  .bt-c { display: flex; flex-direction: column; gap: var(--e-1); }
  .bt-n {
    font-size: var(--t-9); font-weight: var(--peso-max);
    color: var(--negativo); line-height: 1;
    letter-spacing: var(--track-cifra); margin: var(--e-3) 0 var(--e-2);
  }
  .bt-t { margin: var(--e-5) 0 0; font-size: var(--t-4); font-weight: var(--peso-fuerte); color: var(--aviso); }
  .motivos { margin: 0; display: grid; gap: var(--e-4); align-content: center; }
  .motivo { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: var(--e-4); }
  .motivo dt { font-size: var(--t-3); font-weight: var(--peso-fuerte); color: var(--texto); }
  .motivo dd { margin: 0; font-size: var(--t-3); color: var(--texto-2); overflow-wrap: anywhere; }

  .pendientes-nota { margin: 0; }

  /* ── responsive ──────────────────────────────────────────────────────── */
  @media (max-width: 1100px) {
    .hero { grid-template-columns: 1fr; gap: var(--e-7); }
    .hero-gr-in { transform: none; }
    .hero-gr-in:hover { transform: none; }
    .bento { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .tile-galeria, .tile-sesion, .tile-reglas, .tile-plan { grid-column: span 4; }
    .tile-reglas { grid-row: span 1; }
    .tile { grid-column: span 2; }
  }
  @media (max-width: 760px) {
    .bento { grid-template-columns: 1fr; }
    .tile, .tile-galeria, .tile-sesion, .tile-reglas, .tile-plan { grid-column: span 1; grid-row: span 1; }
    .tile-reglas .tile-n { font-size: var(--t-9); }
    .estado, .bt { grid-template-columns: 1fr; gap: var(--e-5); padding: var(--e-5); }
    .motivo { grid-template-columns: 1fr; gap: var(--e-1); }
  }
</style>
