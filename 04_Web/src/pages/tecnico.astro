---
/**
 * Portada tecnica — la del operador.
 *
 * Se llega por el icono discreto del pie del rail, que ademas enciende el
 * modo tecnico. Alfredo no tiene por que pasar por aqui.
 *
 * Es el sitio donde viven ahora el aviso de «plan no probado» y los cuatro
 * huecos declarados. Se muestran, no se esconden: la regla del proyecto se
 * cumple aqui, no en la portada de Alfredo. Y el resultado del backtesting
 * sale en la misma pantalla que sus motivos, como manda CLAUDE.md.
 */
import Marco from '../componentes/Marco.astro';
import Icono from '../componentes/Icono.astro';
import * as P from '../lib/parsers.mjs';

const reglas = P.reglas();
const glosario = P.glosario();
const galeria = P.galeria();
const bt = P.backtesting();
const v = P.version();

// Las once sesiones salen del acta de cierre (CIERRE_FASE_1.md). Es el unico
// numero de esta pagina escrito a mano: no hay de donde derivarlo.
const CIFRAS = [
  { n: reglas.length, t: 'reglas medibles' },
  { n: 11, t: 'sesiones reconstruidas al tick' },
  { n: glosario.length, t: 'términos con definición exacta' },
];

const DETALLE = [
  { icono: 'file-text', href: '/plan-completo', texto: 'El plan completo', sub: 'El documento largo, con el razonamiento de cada regla' },
  { icono: 'list-checks', href: '/reglas', texto: 'Las reglas', sub: `Las ${reglas.length} fichas, con condiciones medibles y acción`, cuenta: reglas.length },
  { icono: 'book-open', href: '/glosario', texto: 'Vocabulario', sub: 'Cada término con su definición medible', cuenta: glosario.length },
  { icono: 'sliders-horizontal', href: '/parametros', texto: 'Parámetros', sub: 'Los números que pueden cambiar, en un solo sitio' },
  { icono: 'check-square', href: '/checklist', texto: 'Checklist diaria', sub: 'La secuencia real del día, en cuatro bloques' },
  { icono: 'images', href: '/galeria', texto: 'Casos reales', sub: 'Las sesiones etiquetadas del gráfico del operador', cuenta: galeria.length },
  { icono: 'warning-circle', href: '/pendientes', texto: 'Pendientes', sub: 'Lo que sigue abierto' },
  { icono: 'stack', href: '/contextualizacion', texto: 'Contextualización', sub: 'Lo que NO es una regla y no debe convertirse en regla' },
  { icono: 'seal-check', href: '/cierre', texto: 'Acta de cierre', sub: 'Qué está probado y qué no' },
];
---

<Marco titulo="Portada técnica">
  <header class="cab entra">
    <h1>Todo el detalle</h1>
    <p class="lead">
      Esta parte es tuya, no de Alfredo. Aquí están las fichas de regla con sus
      códigos, los parámetros, el acta de cierre y el estado real del plan.
      Desde aquí también funciona el buscador de la cabecera.
    </p>
  </header>

  <!-- ── el estado real del plan ───────────────────────────────────────── -->
  <section class="estado vidrio entra" aria-label="Estado del plan">
    <div class="es-txt">
      <span class="marca-estado aviso">plan no probado</span>
      <h2>Escrito y contrastado. No probado.</h2>
      <p>
        El plan está contrastado contra sesiones reales, pero{' '}
        <strong>nunca pasó una prueba a ciegas</strong>. Se cerró con{' '}
        {bt.huecos.length} huecos declarados.
      </p>
      {bt.total && (
        <p class="es-bt">
          Backtesting: <strong class="neg num">{bt.total}</strong> en{' '}
          <span class="num">{bt.operaciones}</span> operaciones — con las
          reservas de abajo, que son por las que esa cifra no mide la
          estrategia.
        </p>
      )}
      <a class="btn-2" href="/cierre">Leer el acta de cierre</a>
    </div>
    <ol class="es-lista">
      {bt.huecos.map((h) => (
        <li set:html={P.tituloAHtml(P.sinNumeracion(h.titulo))} />
      ))}
    </ol>
  </section>

  <!-- ── cifras, en línea y sin tarjetas ───────────────────────────────── -->
  <section class="cifras entra" aria-label="El plan en números">
    {CIFRAS.map((c) => (
      <div class="cifra">
        <span class="c-n num">{c.n}</span>
        <span class="c-t">{c.t}</span>
      </div>
    ))}
  </section>

  <!-- ── el índice del detalle ─────────────────────────────────────────── -->
  <section class="entra" aria-label="Secciones de detalle">
    <h2 class="tit-sec">Secciones</h2>
    <ul class="rejilla">
      {DETALLE.map((d) => (
        <li>
          <a class="ficha" href={d.href}>
            <span class="fi-ic"><Icono nombre={d.icono} /></span>
            <span class="fi-t">
              {d.texto}
              {d.cuenta && <span class="fi-c num">{d.cuenta}</span>}
            </span>
            <span class="fi-s">{d.sub}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <p class="pie-nota meta">Plan versión {v.version}, actualizado el {v.fecha}.</p>
</Marco>

<style>
  .cab { margin-bottom: var(--e-7); }
  .lead { font-size: var(--t-5); color: var(--texto-2); }

  /* ── estado del plan ─────────────────────────────────────────────────── */
  .estado {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--e-7);
    padding: var(--e-7);
    box-shadow: var(--halo-oro), var(--sombra-2);
    margin-bottom: var(--e-8);
  }
  .es-txt h2 { margin: var(--e-4) 0 var(--e-3); font-size: var(--t-6); color: var(--aviso); }
  .es-txt p { font-size: var(--t-4); color: var(--texto-2); }
  /* El rojo, solo aquí: es el unico dato negativo real del portal. */
  .neg { color: var(--negativo); }
  .es-bt { font-size: var(--t-3); }

  .es-lista {
    list-style: none; padding: 0; margin: 0; max-width: none;
    display: grid; gap: var(--e-2); align-content: center;
    counter-reset: hueco;
  }
  .es-lista li {
    counter-increment: hueco;
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--e-3);
    margin: 0; padding: var(--e-3) var(--e-4);
    background: var(--vidrio-fondo);
    border: 1px solid var(--borde-sutil);
    border-radius: var(--radio-2);
    font-size: var(--t-3); color: var(--texto-2);
  }
  /* El numero identifica el hueco sin que el color tenga que hacerlo solo. */
  .es-lista li::before {
    content: counter(hueco);
    font-family: var(--fuente-mono); font-variant-numeric: tabular-nums;
    font-size: var(--t-1); color: var(--aviso);
  }
  .es-lista :global(code) { color: var(--texto-3); font-size: var(--t-1); }

  /* ── cifras ──────────────────────────────────────────────────────────── */
  .cifras {
    display: flex; flex-wrap: wrap; gap: var(--e-8);
    padding: var(--e-6) 0;
    margin-bottom: var(--e-8);
    border-top: 1px solid var(--borde-sutil);
    border-bottom: 1px solid var(--borde-sutil);
  }
  .cifra { display: flex; align-items: baseline; gap: var(--e-3); }
  .c-n {
    font-size: var(--t-8); font-weight: var(--peso-max);
    color: var(--texto); line-height: var(--alto-corto); letter-spacing: var(--track-cifra);
  }
  .c-t { font-size: var(--t-3); color: var(--texto-2); max-width: 14ch; }

  /* ── índice ──────────────────────────────────────────────────────────── */
  .tit-sec { margin: 0 0 var(--e-4); font-size: var(--t-6); }
  .rejilla {
    list-style: none; padding: 0; margin: 0; max-width: none;
    display: grid; gap: var(--e-3);
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  }
  .rejilla li { margin: 0; }

  .ficha {
    display: grid; grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: 'ic t' 'ic s';
    gap: 0 var(--e-3);
    height: 100%;
    padding: var(--e-4);
    border-radius: var(--radio-3);
    border: 1px solid var(--borde-sutil);
    background: var(--vidrio-fondo);
    color: var(--texto);
    transition: background var(--normal), border-color var(--normal), transform var(--normal);
  }
  .ficha:hover {
    background: var(--vidrio-hover);
    border-color: var(--vidrio-borde);
    color: var(--texto);
    transform: translateY(-1px);
  }
  .fi-ic { grid-area: ic; color: var(--texto-3); --i: 1.25rem; transition: color var(--normal); }
  .ficha:hover .fi-ic { color: var(--acento); }
  .fi-t {
    grid-area: t; display: flex; align-items: center; gap: var(--e-2);
    font-size: var(--t-3); font-weight: var(--peso-medio);
  }
  .fi-c {
    font-size: var(--t-1); color: var(--texto-3);
    background: var(--vidrio-hover);
    border-radius: var(--radio-pill);
    padding: 1px var(--e-2);
  }
  .fi-s { grid-area: s; font-size: var(--t-2); color: var(--texto-3); }

  .pie-nota { margin: var(--e-7) 0 0; }

  @media (max-width: 900px) {
    .estado { grid-template-columns: 1fr; gap: var(--e-5); padding: var(--e-5); }
    .cifras { gap: var(--e-6); }
  }
</style>
