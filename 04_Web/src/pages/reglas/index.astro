---
/**
 * Las 38 reglas — el índice.
 *
 * Rehecha el 05/09/2026 con las correcciones del operador:
 *
 *   · AL ENTRAR EN UNA REGLA SE VA A SU FICHA, como siempre. El cajón lateral
 *     que se probó el 04/09 se retiró: no le gustó y la ficha ya existía.
 *
 *   · LOS GRUPOS VIVEN EN EL LATERAL, colgando de «Las reglas». Aquí no hay
 *     barra de pastillas: se filtraba en dos sitios y sobraba uno. La página
 *     lee el grupo del ancla de la dirección (#g=zonas, #g=zonas.marcado).
 *
 *   · EL TEXTO NO SE CORTA. Ni aquí ni en ningún sitio: el tope de 62
 *     caracteres por párrafo salió de tokens.css.
 *
 * Los nombres de los grupos y su orden salen de reglas.json. Aquí no se
 * renombra ninguno ni se decide el orden.
 */
import Marco from '../../componentes/Marco.astro';
import Icono from '../../componentes/Icono.astro';
import * as P from '../../lib/parsers.mjs';

const reglas = P.reglas();
const cats = P.categorias();
const casos = P.casosPorRegla();
const imagenes = P.imagenesDeReglas();

const NOMBRE_SUB = { marcado: 'Marcado', vigencia: 'Vigencia' };
const NOMBRE_CAT = new Map(cats.map((c) => [c.id, c.nombre]));

// Del cian al azul, en el orden que declara el archivo. Mismo recurso que
// modulos.mjs usa para los ocho módulos del recorrido: el tono es una
// posición en la jornada, no un adorno, y por eso se calcula.
const TONO = new Map(cats.map((c, i) => [
  c.id,
  `color-mix(in srgb, var(--info) ${Math.round(100 - (i * 100) / Math.max(cats.length - 1, 1))}%, var(--acento))`,
]));

const etiqueta = (r) => {
  const base = NOMBRE_CAT.get(r.categoria) ?? r.categoria;
  return r.subcategoria ? `${base} · ${NOMBRE_SUB[r.subcategoria] ?? r.subcategoria}` : base;
};
const tambien = (r) => P.ENLACES_CRUZADOS.get(r.id) ?? [];
---

<Marco titulo="Reglas">
  <header class="cab entra">
    <h1>Reglas Trading Plan</h1>
    <p class="lead">
      Las {reglas.length} del método, con sus condiciones medibles y su acción.
      Sin adjetivos: solo ticks, puntos, número de velas y horas exactas.
    </p>
  </header>

  <div class="barra entra">
    <label class="campo">
      <Icono nombre="magnifying-glass" />
      <input type="search" data-filtro autocomplete="off" spellcheck="false"
             placeholder="Buscar por texto o por número de regla" />
      <kbd class="kbd">Ctrl K</kbd>
    </label>
    <p class="estado">
      <span class="grupo" data-grupo-activo hidden></span>
      <span class="cuenta meta"><b data-contador>{reglas.length}</b> de {reglas.length}</span>
    </p>
  </div>

  <p class="vacio" data-vacio hidden>
    Ninguna regla coincide. Prueba con otra palabra, o elige «Todas» en el menú.
  </p>

  <!-- 1 columna en móvil, 2 en tablet, 3 en escritorio. El enunciado NUNCA
       se recorta: manda el texto y la fila crece. -->
  <ul class="rejilla" data-lista>
    {reglas.map((r, i) => (
      <li class="celda entra" style={`--retraso:${Math.min(i, 11) * 22}ms; --c:${TONO.get(r.categoria)}`}
          data-cat={r.categoria}
          data-sub={r.subcategoria ?? ''}
          data-tambien={tambien(r).join(' ')}
          data-txt={[r.id, r.enunciado, r.accion, r.nota, etiqueta(r)].filter(Boolean).join(' ').toLowerCase()}>
        <a class="tarj" href={`/reglas/${r.id}`}>
          <span class="t-cab">
            <span class="badge">{etiqueta(r)}</span>
            <span class="t-id mono">{r.id}</span>
            <span class="t-ir" aria-hidden="true"><Icono nombre="caret-right" /></span>
          </span>

          <span class="t-e">{r.enunciado}</span>

          <span class="t-pie">
            <span class="met"><Icono nombre="list-checks" />{r.condiciones.length} condiciones</span>
            {casos.has(r.id) && (
              <span class="met"><Icono nombre="images" />{casos.get(r.id).length} casos</span>
            )}
            {imagenes.has(r.id) && (
              <span class="met"><Icono nombre="image-square" />diagrama</span>
            )}
            {tambien(r).map((id) => (
              <span class="met cruz">también en {NOMBRE_CAT.get(id) ?? id}</span>
            ))}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Marco>

<script is:inline define:vars={{ NOMBRES: Object.fromEntries(cats.map((c) => [c.id, c.nombre])), SUBS: NOMBRE_SUB }}>
  (function () {
    var campo = document.querySelector('[data-filtro]');
    if (!campo) return;

    var celdas = [].slice.call(document.querySelectorAll('.celda'));
    var contador = document.querySelector('[data-contador]');
    var vacio = document.querySelector('[data-vacio]');
    var rotulo = document.querySelector('[data-grupo-activo]');
    var enlaces = [].slice.call(document.querySelectorAll('[data-grupo]'));

    var cat = '';
    var sub = '';

    function aplicar() {
      var q = campo.value.trim().toLowerCase();
      var n = 0;
      celdas.forEach(function (c) {
        // Una regla entra por su grupo o por aquellos desde los que TAMBIÉN
        // contesta: la del rompimiento vive en Zonas y responde en Setup.
        var suyas = (c.getAttribute('data-cat') + ' ' + (c.getAttribute('data-tambien') || '')).split(' ');
        var okCat = !cat || suyas.indexOf(cat) >= 0;
        var okSub = !sub || c.getAttribute('data-sub') === sub;
        var okTxt = !q || c.getAttribute('data-txt').indexOf(q) >= 0;
        var ver = okCat && okSub && okTxt;
        c.hidden = !ver;
        if (ver) n++;
      });
      contador.textContent = n;
      vacio.hidden = n > 0;

      var nombre = cat ? (NOMBRES[cat] || cat) : '';
      if (nombre && sub) nombre += ' · ' + (SUBS[sub] || sub);
      rotulo.textContent = nombre;
      rotulo.hidden = !nombre;
    }

    // El grupo se elige en el menú de la izquierda y viaja en el ancla, así
    // que funciona igual llegando de otra página o volviendo con el botón de
    // atrás del navegador.
    function delAncla() {
      var m = /^#g=([a-z_]+)(?:\.([a-z_]+))?$/.exec(location.hash || '');
      cat = m ? m[1] : '';
      sub = m && m[2] ? m[2] : '';
      var clave = cat + (sub ? '.' + sub : '');
      enlaces.forEach(function (a) {
        a.classList.toggle('activa', a.getAttribute('data-grupo') === clave);
      });
      aplicar();
    }

    window.addEventListener('hashchange', delAncla);
    campo.addEventListener('input', aplicar);

    // Ctrl/Cmd + K y escribir con el foco fuera llevan al buscador: durante
    // la sesión no hay tiempo de ir al ratón.
    document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault(); campo.focus(); campo.select(); return;
      }
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      var d = document.activeElement;
      if (d && (d.tagName === 'INPUT' || d.tagName === 'TEXTAREA' || d.isContentEditable)) return;
      if (e.key === 'Escape' && campo.value) { campo.value = ''; aplicar(); return; }
      if (e.key.length !== 1 || !/[\wáéíóúñ-]/i.test(e.key)) return;
      campo.focus();
    });

    delAncla();
  })();
</script>

<style>
  /* ── cabecera ─────────────────────────────────────────────────────────
     Mismo tratamiento que el título de un módulo: centrado, en mayúscula y
     arriba del todo. Es la misma jerarquía, así que se ve igual. */
  .cab {
    text-align: center;
    margin: calc(var(--e-6) * -1) 0 var(--e-7);
  }
  .cab h1 {
    margin: 0 0 var(--e-3);
    font-size: clamp(var(--t-7), 3vw, var(--t-8));
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--acento);
    text-wrap: balance;
  }
  .lead {
    font-size: var(--t-5); color: var(--texto-2);
    max-width: 52ch; margin: 0 auto;
  }

  /* ── buscador ─────────────────────────────────────────────────────── */
  .barra {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-3) var(--e-4);
    margin-bottom: var(--e-6);
  }
  .campo {
    flex: 1 1 22rem;
    display: flex; align-items: center; gap: var(--e-3);
    padding: var(--e-3) var(--e-4);
    background: var(--vidrio-fondo);
    border: 1px solid var(--vidrio-borde);
    border-radius: var(--radio-2);
    backdrop-filter: var(--desenfoque);
    color: var(--texto-3);
    transition: border-color var(--normal), box-shadow var(--normal);
  }
  .campo:focus-within {
    border-color: color-mix(in srgb, var(--acento) 60%, transparent);
    box-shadow: var(--halo-azul);
  }
  .campo input {
    flex: 1; min-width: 0; background: none; border: 0; outline: none;
    color: var(--texto); font: inherit; font-size: var(--t-3);
  }
  .campo input::placeholder { color: var(--texto-3); }
  .campo input::-webkit-search-cancel-button { display: none; }
  .kbd {
    font-family: var(--fuente-mono); font-size: var(--t-1);
    padding: 0.1rem 0.4rem; border-radius: var(--radio-1);
    border: 1px solid var(--borde-sutil); color: var(--texto-3);
    white-space: nowrap;
  }

  .estado { display: flex; align-items: center; gap: var(--e-3); margin: 0; }
  .grupo {
    font-size: var(--t-2); color: var(--texto-2);
    padding: var(--e-1) var(--e-3);
    border-radius: var(--radio-pill);
    background: color-mix(in srgb, var(--acento) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--acento) 40%, transparent);
  }
  .grupo[hidden] { display: none; }
  .cuenta { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cuenta b { color: var(--texto); font-weight: var(--peso-medio); }

  .vacio { color: var(--texto-2); font-size: var(--t-3); padding: var(--e-6) 0; }

  /* ── rejilla ──────────────────────────────────────────────────────── */
  .rejilla {
    list-style: none; padding: 0; margin: 0; max-width: none;
    display: grid; gap: var(--e-3);
    grid-template-columns: 1fr;
  }
  @media (min-width: 46rem) { .rejilla { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 78rem) { .rejilla { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .celda { margin: 0; }
  .celda[hidden] { display: none; }

  /* ── tarjeta ──────────────────────────────────────────────────────── */
  .tarj {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; gap: var(--e-3);
    height: 100%;
    padding: var(--e-4) var(--e-4) var(--e-5);
    border-radius: var(--radio-3);
    background: var(--vidrio-fondo);
    background-image: var(--vidrio-brillo);
    border: 1px solid var(--vidrio-borde);
    color: var(--texto-2);
    transition: transform var(--normal), box-shadow var(--normal), border-color var(--normal);
  }
  /* El filo de color dice de qué grupo es sin tener que leer la etiqueta. */
  .tarj::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 2px;
    background: var(--c, var(--acento)); opacity: 0.5;
    transition: opacity var(--normal);
  }
  .tarj:hover, .tarj:focus-visible {
    transform: translateY(-2px);
    color: var(--texto-2);
    border-color: color-mix(in srgb, var(--c, var(--acento)) 40%, var(--vidrio-borde));
    box-shadow: var(--halo-azul), var(--sombra-2);
  }
  .tarj:hover::before, .tarj:focus-visible::before { opacity: 1; }

  .t-cab { display: flex; align-items: center; gap: var(--e-2); }
  .badge {
    display: inline-flex; align-items: center;
    padding: 0.15rem var(--e-2);
    border-radius: var(--radio-1);
    background: color-mix(in srgb, var(--c, var(--acento)) 16%, transparent);
    color: color-mix(in srgb, var(--c, var(--acento)) 75%, var(--texto));
    font-size: var(--t-1); font-weight: var(--peso-fuerte);
    letter-spacing: var(--track-etiqueta); text-transform: uppercase;
  }
  .t-id { font-size: var(--t-1); color: var(--texto-3); }
  .t-ir {
    margin-left: auto; display: flex; --i: 1rem; color: var(--texto-3);
    transition: transform var(--normal), color var(--normal);
  }
  .tarj:hover .t-ir { transform: translateX(3px); color: var(--c, var(--acento)); }

  .t-e {
    font-size: var(--t-4); line-height: 1.45;
    color: var(--texto); font-weight: var(--peso-medio);
    text-wrap: pretty;
  }

  .t-pie {
    display: flex; flex-wrap: wrap; gap: var(--e-2) var(--e-4);
    margin-top: auto; padding-top: var(--e-2);
    font-size: var(--t-1); color: var(--texto-3);
  }
  .met { display: inline-flex; align-items: center; gap: var(--e-1); --i: 0.9rem; }
  .met.cruz { font-style: italic; }
</style>
